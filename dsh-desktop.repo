# 两个渠道共用这一份文件：stable 默认启用，nightly 默认关闭。
# 手动 dnf 走 stable（不加任何 --enablerepo 就是 stable）；应用内切换渠道时由
# /usr/libexec/dsh-update-helper 显式 --disablerepo 另一个、--enablerepo 所选的那个，
# 因此这里的 enabled= 只影响手动 dnf，不影响应用内渠道。
[dsh-desktop]
name=DSH Linux Desktop (stable)
baseurl=https://zk-andy.github.io/DSH-Linux-Desktop/stable/
enabled=1
gpgcheck=1
repo_gpgcheck=1
# 公钥取自本 Release（装包后由 rpm 提供本机文件）
gpgkey=https://github.com/ZK-Andy/DSH-Linux-Desktop/releases/latest/download/RPM-GPG-KEY-dsh-desktop
metadata_expire=1h
# 仓库不可达时不影响其他 dnf 事务；应用内检查会显式关掉这一项以便报错。
skip_if_unavailable=1

[dsh-desktop-nightly]
name=DSH Linux Desktop (nightly)
baseurl=https://zk-andy.github.io/DSH-Linux-Desktop/nightly/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://github.com/ZK-Andy/DSH-Linux-Desktop/releases/latest/download/RPM-GPG-KEY-dsh-desktop
metadata_expire=1h
skip_if_unavailable=1
