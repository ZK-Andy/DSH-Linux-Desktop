+++ b/apps/desktop/resources/sharp-worker.cjs
@@ -0,0 +1,57 @@
+'use strict'
+
+/**
+ * Isolated Sharp runner. Electron's Linux process links its own glib, which
+ * aborts libvips (electron/electron#46323); this child runs plain Node instead.
+ */
+
+const { createRequire } = require('node:module')
+const { join } = require('node:path')
+const { createInterface } = require('node:readline')
+
+const moduleDirectory = process.env.DSH_SHARP_MODULE_DIR
+if (moduleDirectory === undefined || moduleDirectory === '') {
+  process.stderr.write('sharp worker: DSH_SHARP_MODULE_DIR is required\n')
+  process.exit(2)
+}
+const sharp = createRequire(join(moduleDirectory, 'sharp-worker.cjs'))('sharp')
+
+/**
+ * Run one recorded Sharp pipeline and reply with the terminal result.
+ * @param {object} request - Recorded input, pipeline operations, and terminal call.
+ * @returns {Promise<object>} Serialized result for the desktop process.
+ */
+async function execute(request) {
+  let pipeline = sharp(Buffer.from(request.input, 'base64'), request.options ?? {})
+  for (const op of request.ops) pipeline = pipeline[op.name](...(op.args ?? []))
+  const value = await pipeline[request.terminal](...(request.args ?? []))
+  if (Buffer.isBuffer(value)) return { kind: 'buffer', base64: value.toString('base64') }
+  if (value !== null && typeof value === 'object' && Buffer.isBuffer(value.data)) {
+    return { kind: 'object', value: { ...value, data: value.data.toString('base64') } }
+  }
+  return { kind: 'value', value }
+}
+
+const lines = createInterface({ input: process.stdin })
+lines.on('line', (line) => {
+  let request
+  try {
+    request = JSON.parse(line)
+  } catch (error) {
+    process.stderr.write(`sharp worker: malformed request: ${String(error)}\n`)
+    return
+  }
+  execute(request).then(
+    (result) => { process.stdout.write(`${JSON.stringify({ id: request.id, ok: true, result })}\n`) },
+    (error) => {
+      process.stdout.write(`${JSON.stringify({
+        id: request.id,
+        ok: false,
+        error: {
+          message: error instanceof Error ? error.message : String(error),
+          code: typeof error === 'object' && error !== null && 'code' in error ? String(error.code) : undefined,
+        },
+      })}\n`)
+    },
+  )
+})
