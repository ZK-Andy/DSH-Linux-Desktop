diff --git a/packages/attachment/attachment-local/src/sharp-worker-client.ts b/packages/attachment/attachment-local/src/sharp-worker-client.ts
new file mode 100644
index 00000000..96c249da
--- /dev/null
+++ b/packages/attachment/attachment-local/src/sharp-worker-client.ts
@@ -0,0 +1,176 @@
+/** Remote Sharp runner: keeps libvips out of Electron's process (electron/electron#46323). */
+
+import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { createInterface } from 'node:readline'
+import type sharp from 'sharp'
+
+type SharpFactory = typeof sharp
+type SharpInstance = ReturnType<SharpFactory>
+
+/** One recorded builder call replayed by the worker. */
+interface RecordedCall {
+  readonly name: string
+  readonly args: readonly unknown[]
+}
+
+/** Calls that end a pipeline and cross the process boundary. */
+const TERMINAL_CALLS = new Set(['toBuffer', 'toFile', 'metadata', 'stats'])
+
+/** Resources directory reported by Electron; absent under plain Node. */
+const resourcesDirectory: string | undefined = Reflect.get(process, 'resourcesPath') as string | undefined
+
+/** Places a packaged build can keep the hoisted sharp module, relative to the resources directory. */
+const PACKAGED_MODULE_DIRECTORIES = [
+  join('app.asar.unpacked', 'dsh', 'node_modules'),
+  join('app.asar.unpacked', 'node_modules'),
+  join('app.asar.unpacked', 'dsh', 'packages', 'attachment', 'attachment-local', 'node_modules'),
+]
+
+/**
+ * Locate the unpacked sharp module inside a packaged application.
+ * @returns The first candidate directory that actually contains sharp, or undefined outside a package.
+ */
+function packagedModuleDirectory(): string | undefined {
+  if (resourcesDirectory === undefined) return undefined
+  return PACKAGED_MODULE_DIRECTORIES
+    .map((relative) => join(resourcesDirectory, relative))
+    .find((candidate) => existsSync(join(candidate, 'sharp', 'package.json')))
+}
+
+function configured(name: string, fallback: string): string | undefined {
+  const explicit = process.env[name]
+  if (explicit !== undefined && explicit !== '') return explicit
+  return resourcesDirectory === undefined ? undefined : join(resourcesDirectory, fallback)
+}
+
+interface WorkerReply {
+  readonly id: number
+  readonly ok: boolean
+  readonly result?: { readonly kind: 'buffer'; readonly base64: string }
+    | { readonly kind: 'object'; readonly value: Record<string, unknown> }
+    | { readonly kind: 'value'; readonly value: unknown }
+  readonly error?: { readonly message: string; readonly code?: string }
+}
+
+/** Serializes pipelines over one long-lived worker process. */
+class SharpWorkerClient {
+  private child: ChildProcessWithoutNullStreams | undefined
+  private readonly pending = new Map<number, { resolve: (value: unknown) => void; reject: (error: Error) => void }>()
+  private sequence = 0
+
+  constructor(
+    private readonly nodeBinary: string,
+    private readonly workerScript: string,
+    private readonly moduleDirectory: string,
+  ) {}
+
+  private start(): ChildProcessWithoutNullStreams {
+    const child = spawn(this.nodeBinary, [this.workerScript], {
+      stdio: ['pipe', 'pipe', 'pipe'],
+      env: { ...process.env, DSH_SHARP_MODULE_DIR: this.moduleDirectory },
+    })
+    createInterface({ input: child.stdout }).on('line', (line) => { this.settle(line) })
+    child.stderr.on('data', (chunk: Buffer) => { process.stderr.write(chunk) })
+    // The worker must not keep its parent alive once the Host shuts down.
+    child.unref()
+    for (const stream of [child.stdin, child.stdout, child.stderr]) {
+      const unref = Reflect.get(stream, 'unref')
+      if (typeof unref === 'function') unref.call(stream)
+    }
+    child.once('exit', (code) => { this.rejectAll(new Error(`sharp worker exited with ${String(code ?? 'signal')}`)) })
+    child.once('error', (error) => { this.rejectAll(error) })
+    return child
+  }
+
+  private settle(line: string): void {
+    const reply = JSON.parse(line) as WorkerReply
+    const waiter = this.pending.get(reply.id)
+    if (waiter === undefined) return
+    this.pending.delete(reply.id)
+    if (!reply.ok) {
+      const error = new Error(reply.error?.message ?? 'sharp worker failed')
+      if (reply.error?.code !== undefined) Reflect.set(error, 'code', reply.error.code)
+      waiter.reject(error)
+      return
+    }
+    const result = reply.result
+    if (result === undefined) { waiter.resolve(undefined); return }
+    if (result.kind === 'buffer') { waiter.resolve(Buffer.from(result.base64, 'base64')); return }
+    if (result.kind === 'object') {
+      const { data, ...rest } = result.value
+      waiter.resolve(typeof data === 'string' ? { ...rest, data: Buffer.from(data, 'base64') } : result.value)
+      return
+    }
+    waiter.resolve(result.value)
+  }
+
+  private rejectAll(error: Error): void {
+    this.child = undefined
+    for (const waiter of this.pending.values()) waiter.reject(error)
+    this.pending.clear()
+  }
+
+  call(input: Buffer, options: unknown, calls: readonly RecordedCall[], terminal: string,
+    args: readonly unknown[]): Promise<unknown> {
+    this.child ??= this.start()
+    const id = ++this.sequence
+    return new Promise((resolve, reject) => {
+      this.pending.set(id, { resolve, reject })
+      this.child?.stdin.write(`${JSON.stringify({
+        id,
+        input: input.toString('base64'),
+        options,
+        ops: calls,
+        terminal,
+        args,
+      })}\n`)
+    })
+  }
+}
+
+/**
+ * Build a fluent Sharp stand-in whose pipeline executes in the worker process.
+ * @param client - Worker connection shared by every pipeline.
+ * @param input - Encoded source bytes.
+ * @param options - Constructor options forwarded to the worker.
+ * @param calls - Recorded builder calls, replayed in order.
+ * @returns A Sharp instance that records calls until a terminal operation runs.
+ */
+function builder(client: SharpWorkerClient, input: Buffer, options: unknown, calls: readonly RecordedCall[]): SharpInstance {
+  const target = function recordedPipeline(): void {}
+  const handler: ProxyHandler<typeof target> = {
+    get(_target, property) {
+      if (typeof property !== 'string' || property === 'then') return undefined
+      if (property === 'clone') return () => builder(client, input, options, calls)
+      return (...args: unknown[]): unknown => {
+        if (TERMINAL_CALLS.has(property)) return client.call(input, options, calls, property, args)
+        return builder(client, input, options, [...calls, { name: property, args }])
+      }
+    },
+  }
+  return new Proxy(target, handler) as unknown as SharpInstance
+}
+
+/**
+ * Create the Sharp factory used by attachment decoding.
+ * @returns A factory that forwards every pipeline to the isolated worker.
+ */
+export function createSharpRunner(): SharpFactory {
+  // Packaged: everything is resolved under the packaged resources directory, so no environment setup.
+  // Development and tests: the worker and module directory cannot be inferred from a packager layout,
+  // and the plugin entry point has nowhere else to read them from, so they must be set explicitly.
+  const nodeBinary = configured('DSH_SHARP_NODE_BIN', join('runtime', 'primary-runtime', 'dependencies', 'node', 'bin', 'node')) ?? 'node'
+  const workerScript = configured('DSH_SHARP_WORKER', 'sharp-worker.cjs')
+  const explicitModuleDirectory = process.env.DSH_SHARP_MODULE_DIR
+  const moduleDirectory = explicitModuleDirectory !== undefined && explicitModuleDirectory !== ''
+    ? explicitModuleDirectory
+    : packagedModuleDirectory()
+  if (workerScript === undefined || moduleDirectory === undefined) {
+    throw new Error('sharp runner: cannot locate sharp; set DSH_SHARP_WORKER and DSH_SHARP_MODULE_DIR outside a packaged application')
+  }
+  const client = new SharpWorkerClient(nodeBinary, workerScript, moduleDirectory)
+  return ((input: Buffer | Uint8Array, options?: unknown) =>
+    builder(client, Buffer.from(input), options, [])) as unknown as SharpFactory
+}
