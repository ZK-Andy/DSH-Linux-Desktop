@@ -0,0 +1,69 @@
+/** Select the Linux package formats one run emits and resolve the control metadata they carry. */
+
+/** Environment variable that selects the Linux package formats one packaging run emits. */
+export const LINUX_FORMATS_ENV = 'DSH_DESKTOP_TARGET_FORMATS'
+
+/** Environment variable that supplies the maintainer recorded in the Debian and RPM control files. */
+export const LINUX_MAINTAINER_ENV = 'DSH_DESKTOP_LINUX_MAINTAINER'
+
+/** Environment variable that supplies the project URL recorded in the Debian and RPM control files. */
+export const LINUX_HOMEPAGE_ENV = 'DSH_DESKTOP_LINUX_HOMEPAGE'
+
+const DEFAULT_FORMATS = ['AppImage']
+
+// fpm builds these from a control file that names a maintainer and a project URL, and refuses to
+// build either format without them.
+const METADATA_FORMATS = new Set(['deb', 'rpm'])
+
+const MAINTAINER = /^[^<>]+<[^<>\s]+@[^<>\s]+>$/u
+
+/**
+ * Resolve the Linux package formats this run emits.
+ * @param {NodeJS.ProcessEnv} environment Packaging environment.
+ * @returns {string[]} Format names in build order, without duplicates; AppImage unless configured.
+ */
+export function resolveDesktopLinuxFormats(environment = process.env) {
+  const configured = environment[LINUX_FORMATS_ENV]
+  if (configured === undefined || configured.trim() === '') return DEFAULT_FORMATS
+  const formats = configured.split(',').map(format => format.trim())
+  if (formats.some(format => format === '')) {
+    throw new Error(`desktop package: ${LINUX_FORMATS_ENV} must be a comma-separated list of target names without empty entries`)
+  }
+  return [...new Set(formats)]
+}
+
+/**
+ * Resolve the control metadata the selected formats carry.
+ * @param {NodeJS.ProcessEnv} environment File-owned release settings.
+ * @param {string[]} formats Formats this run emits; defaults to the resolved selection.
+ * @returns {{ maintainer: string, homepage: string } | undefined} Metadata, or undefined when no selected format carries any.
+ */
+export function resolveDesktopLinuxPackageMetadata(environment = process.env, formats = resolveDesktopLinuxFormats(environment)) {
+  const requiring = formats.filter(format => METADATA_FORMATS.has(format))
+  if (requiring.length === 0) return undefined
+  const maintainer = environment[LINUX_MAINTAINER_ENV]?.trim() ?? ''
+  const homepage = environment[LINUX_HOMEPAGE_ENV]?.trim() ?? ''
+  const problems = []
+  if (!MAINTAINER.test(maintainer)) {
+    problems.push(`${LINUX_MAINTAINER_ENV} must be "Name <email>", the maintainer of this package rather than the upstream author`)
+  }
+  if (!isAbsoluteHttpUrl(homepage)) {
+    problems.push(`${LINUX_HOMEPAGE_ENV} must be an absolute http or https URL`)
+  }
+  if (problems.length > 0) {
+    const listed = requiring.join(' and ')
+    throw new Error(`desktop package: ${listed} ${requiring.length === 1 ? 'carries' : 'carry'} a maintainer and a project URL:\n${
+      problems.map(problem => `  ${problem}`).join('\n')}`)
+  }
+  return { maintainer, homepage }
+}
+
+function isAbsoluteHttpUrl(value) {
+  let url
+  try { url = new URL(value) }
+  catch {
+    // The URL parser rejects every relative or malformed value, which is what this predicate reports.
+    return false
+  }
+  return url.protocol === 'https:' || url.protocol === 'http:'
+}
