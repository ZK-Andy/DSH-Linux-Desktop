diff --git a/apps/desktop/src/preload-linux-frame.ts b/apps/desktop/src/preload-linux-frame.ts
new file mode 100644
index 00000000..9b827f68
--- /dev/null
+++ b/apps/desktop/src/preload-linux-frame.ts
@@ -0,0 +1,45 @@
+/**
+ * Linux frameless primary window: the document marks itself as caption-less and
+ * the application renders the window controls (ui-layout's WindowControls), so
+ * the native titlebar adds nothing.
+ *
+ * The window is opaque. A transparent window would let the compositor round the
+ * corners against the desktop, but transparency on Wayland costs a per-frame
+ * alpha composite of the whole window and has been the least reliable part of
+ * Electron's Linux window support; the panel is therefore painted by the client
+ * bundles at full window size. The page keeps the caption-less geometry DSH
+ * already ships, and this preload contributes only the product API the page
+ * uses to drive minimize/maximize/close through the main process.
+ */
+
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC, type DesktopWindowControlsApi, type DesktopWindowState } from './ipc.ts'
+
+/** Preload argument marking the application document as a frameless Linux window. */
+export const FRAME_ARGUMENT = '--dsh-desktop-frame'
+
+/** Whether the primary window draws its own frame: every Linux desktop build does. */
+export function desktopFrameless(): boolean {
+  return process.platform === 'linux'
+}
+
+/**
+ * Product API for the frameless window's controls. The page renders the buttons;
+ * the main process owns the window and validates the sender of every command.
+ * @returns The window-controls surface exposed on `window.dshDesktop`.
+ */
+export function createLinuxWindowControls(): DesktopWindowControlsApi {
+  return {
+    minimize: () => ipcRenderer.invoke(DESKTOP_IPC.windowAction, 'minimize') as Promise<void>,
+    toggleMaximize: () => ipcRenderer.invoke(DESKTOP_IPC.windowAction, 'toggle-maximize') as Promise<void>,
+    close: () => ipcRenderer.invoke(DESKTOP_IPC.windowAction, 'close') as Promise<void>,
+    state: () => ipcRenderer.invoke(DESKTOP_IPC.windowStateGet) as Promise<DesktopWindowState>,
+    subscribe(listener) {
+      const handle = (_event: Electron.IpcRendererEvent, maximized: boolean): void => {
+        listener({ maximized, fullscreen: document.documentElement.hasAttribute('data-fullscreen') })
+      }
+      ipcRenderer.on(DESKTOP_IPC.windowState, handle)
+      return () => { ipcRenderer.off(DESKTOP_IPC.windowState, handle) }
+    },
+  }
+}
