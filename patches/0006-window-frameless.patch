+import { app, ipcMain, type BrowserWindow } from 'electron'
+import { join } from 'node:path'
+import { DESKTOP_IPC, assertDesktopSender } from './ipc.ts'
+
+/** Task icon for the frameless window: Wayland ignores it, X11 sessions draw it. */
+export function framelessWindowIcon(): string | undefined {
+  if (process.platform !== 'linux') return undefined
+  return app.isPackaged
+    ? join(process.resourcesPath, 'app-icon.png')
+    : join(app.getAppPath(), 'resources/icons-linux/256x256.png')
+}
+
+/**
+ * Opaque frameless window options: the window fills its whole rectangle and never asks the
+ * compositor for an alpha surface. The fill is painted at creation so showing the window
+ * before the page loads cannot flash a white rectangle.
+ * @param fill - chrome fill for the current theme.
+ */
+export function linuxFramelessWindowOptions(fill: string): Partial<Electron.BrowserWindowConstructorOptions> {
+  return {
+    backgroundColor: fill,
+    frame: false,
+    hasShadow: false,
+  }
+}
+
+/** Frameless windows keep Electron's native menu bar out: some desktops show it otherwise. */
+export function hideLinuxMenuBar(window: BrowserWindow): void {
+  if (process.platform === 'linux') window.setMenuBarVisibility(false)
+}
+
+/**
+ * Mirrors the frameless window state the preload button band renders: a maximized restore
+ * toggles the glyph. Resent after every load, because a reload drops the preload listeners.
+ * @param window - frameless window to keep in sync.
+ */
+export function attachFramelessWindowState(window: BrowserWindow): void {
+  const sendWindowState = (): void => {
+    if (!window.isDestroyed()) window.webContents.send(DESKTOP_IPC.windowState, window.isMaximized())
+  }
+  window.on('maximize', sendWindowState)
+  window.on('unmaximize', sendWindowState)
+  window.webContents.on('did-finish-load', sendWindowState)
+}
+
+/**
+ * Fullscreen hides the window controls and overlays drop their caption clearance. Resent after
+ * every load so a fullscreen reload does not fall back to windowed CSS.
+ * @param window - window whose fullscreen state is relayed to the page.
+ */
+export function attachFullscreenState(window: BrowserWindow): void {
+  const sendFullscreen = (): void => {
+    if (!window.isDestroyed()) window.webContents.send(DESKTOP_IPC.windowFullscreen, window.isFullScreen())
+  }
+  window.on('enter-full-screen', sendFullscreen)
+  window.on('leave-full-screen', sendFullscreen)
+  window.webContents.on('did-finish-load', sendFullscreen)
+}
+
+/**
+ * Window controls live in the frame because the frameless window has no native caption.
+ * Only the window's own renderer may drive them.
+ * @param current - resolves the primary window, which may not exist yet.
+ */
+export function registerLinuxWindowIpc(current: () => BrowserWindow | undefined): void {
+  ipcMain.handle(DESKTOP_IPC.windowAction, (event, action: unknown) => {
+    assertDesktopSender(event, ['app'])
+    const window = current()
+    if (window === undefined || event.sender !== window.webContents
+      || event.senderFrame !== window.webContents.mainFrame) throw new Error('desktop window: rejected sender')
+    if (action === 'minimize') return window.minimize()
+    if (action === 'toggle-maximize') return window.isMaximized() ? window.unmaximize() : window.maximize()
+    if (action === 'close') return window.close()
+    throw new Error('desktop window: unknown action')
+  })
+  ipcMain.handle(DESKTOP_IPC.windowStateGet, (event) => {
+    assertDesktopSender(event, ['app'])
+    const window = current()
+    if (window === undefined || event.sender !== window.webContents) throw new Error('desktop window: rejected sender')
+    return { maximized: window.isMaximized(), fullscreen: window.isFullScreen() }
+  })
+}
