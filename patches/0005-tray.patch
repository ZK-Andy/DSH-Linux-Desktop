+/**
+ * Linux-only shell copy: the tray menu entries and the About dialog lines the Desktop adds.
+ *
+ * Keeping them here rather than in the upstream dictionaries means `locale.ts` owns one expansion
+ * point (`resolveDesktopLocale`) instead of eight insertion points, and the packaging modules can
+ * gain copy without touching the shared message file (see PLAN.md §3.1, AGENTS.md rule 3).
+ */
+
+/** Copy added by the Linux tray and About dialog, per shipped language. */
+export const linuxMessages = {
+  en: {
+    aboutTrayMenu: 'About',
+    aboutUpstreamVersion: 'DSH version: V{version}',
+    checkForUpdates: 'Check for Updates',
+  },
+  zh: {
+    aboutTrayMenu: '关于',
+    aboutUpstreamVersion: 'DSH 版本：V{version}',
+    checkForUpdates: '检查更新',
+  },
+  ja: {
+    aboutTrayMenu: '情報',
+    aboutUpstreamVersion: 'DSH バージョン: V{version}',
+    checkForUpdates: 'アップデートを確認',
+  },
+  es: {
+    aboutTrayMenu: 'Acerca de',
+    aboutUpstreamVersion: 'Versión de DSH: V{version}',
+    checkForUpdates: 'Buscar actualizaciones',
+  },
+  fr: {
+    aboutTrayMenu: 'À propos',
+    aboutUpstreamVersion: 'Version de DSH : V{version}',
+    checkForUpdates: 'Rechercher des mises à jour',
+  },
+  de: {
+    aboutTrayMenu: 'Über',
+    aboutUpstreamVersion: 'DSH-Version: V{version}',
+    checkForUpdates: 'Nach Updates suchen',
+  },
+  ru: {
+    aboutTrayMenu: 'О программе',
+    aboutUpstreamVersion: 'Версия DSH: V{version}',
+    checkForUpdates: 'Проверить обновления',
+  },
+  pt: {
+    aboutTrayMenu: 'Sobre',
+    aboutUpstreamVersion: 'Versão do DSH: V{version}',
+    checkForUpdates: 'Verificar atualizações',
+  },
+} as const satisfies Record<string, Record<string, string>>
+
+/** The Linux additions, widened to strings so every language satisfies the same shape. */
+export type LinuxMessages = { readonly [Key in keyof (typeof linuxMessages)['en']]: string }
+
+/** Keys of {@link LinuxMessages}, for lookups that fall back to English. */
+export type LinuxMessageKey = keyof LinuxMessages
+
+/**
+ * Adds the Linux copy to one upstream dictionary.
+ * @param dictionary - Upstream messages for the selected language.
+ * @param key - Dictionary key the language resolves to.
+ * @returns the merged message set.
+ */
+export function withLinuxMessages<Messages extends Record<string, string>>(
+  dictionary: Messages,
+  key: keyof typeof linuxMessages,
+): Messages & LinuxMessages {
+  return { ...dictionary, ...linuxMessages[key] }
+}
