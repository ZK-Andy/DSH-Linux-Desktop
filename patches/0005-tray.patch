diff --git a/apps/desktop/src/linux-tray.ts b/apps/desktop/src/linux-tray.ts
new file mode 100644
index 0000000..0720ef9
--- /dev/null
+++ b/apps/desktop/src/linux-tray.ts
@@ -0,0 +1,45 @@
+import { app } from 'electron'
+import { join } from 'node:path'
+import { DesktopTray } from './tray.ts'
+import type { DesktopLocale } from './locale.ts'
+
+export interface LinuxTrayOptions {
+  development: boolean
+  locale: () => DesktopLocale
+  open: () => void
+  checkUpdate: () => void
+  restart: () => void
+  quit: () => void
+  about: () => void
+}
+
+/**
+ * Tray path: Windows picks a bitmap out of the multi-size ICO by display scale, while Linux's
+ * StatusNotifierItem host scales the single PNG to the panel's icon size instead.
+ * @param development - unpackaged runs read the icon from the checkout.
+ */
+export function trayIconPath(development: boolean): string {
+  return development
+    ? join(app.getAppPath(), 'resources', process.platform === 'win32' ? 'tray-windows.ico' : 'tray-linux.png')
+    : join(process.resourcesPath, process.platform === 'win32' ? 'tray.ico' : 'tray-linux.png')
+}
+
+/**
+ * The tray is the way back to a hidden window. On Linux the context menu is the entry that
+ * always works: a StatusNotifierItem host is free to show the menu on a left click instead of
+ * forwarding one, so the menu carries open, update, restart, quit and about.
+ * @param options - shell callbacks and icon source.
+ */
+export function createLinuxTray(options: LinuxTrayOptions): DesktopTray {
+  return new DesktopTray({
+    iconPath: trayIconPath(options.development),
+    locale: options.locale,
+    open: options.open,
+    // Same entry point as the application menu; a manual check reports "already current" when there is nothing newer.
+    checkUpdate: options.checkUpdate,
+    // Restart keeps the same argv and skips the quit confirmation the user just answered by choosing it.
+    restart: options.restart,
+    quit: options.quit,
+    about: options.about,
+  })
+}
