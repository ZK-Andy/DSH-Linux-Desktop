diff --git a/apps/desktop/scripts/electron-builder-linux.mjs b/apps/desktop/scripts/electron-builder-linux.mjs
new file mode 100644
index 00000000..2a7ad6ab
--- /dev/null
+++ b/apps/desktop/scripts/electron-builder-linux.mjs
@@ -0,0 +1,122 @@
+/**
+ * Linux packaging decisions: the target options, the package identity and the rpm hardening all live
+ * here, so `electron-builder-config.mjs` keeps a single expansion point for them (see PLAN.md §3.2).
+ * `withLinuxTargets` is a no-op on other platforms.
+ */
+import { fileURLToPath } from 'node:url'
+
+/** Path to a file under `apps/desktop/resources`. */
+function resource(name) {
+  return fileURLToPath(new URL(`../resources/${name}`, import.meta.url))
+}
+
+/** Files the rpm installs or the application reads at runtime; they must exist outside the archive. */
+function linuxExtraResources() {
+  return [
+    // Linux gets the single PNG its StatusNotifierItem host scales to the panel instead of the
+    // multi-size ICO Windows picks from.
+    { from: resource('tray-linux.png'), to: 'tray-linux.png' },
+    // The Sharp worker is spawned by path, and a plain-Node process cannot read inside app.asar.
+    { from: resource('sharp-worker.cjs'), to: 'sharp-worker.cjs' },
+    // The frameless window hands this bitmap to BrowserWindow for X11 task switching.
+    { from: resource('icons-linux/256x256.png'), to: 'app-icon.png' },
+    // Update chain: the rpm %post installs these copies; the application never writes to /usr itself.
+    { from: resource('dsh-update-helper'), to: 'dsh-update-helper' },
+    { from: resource('org.deepseek.harness.desktop.update.policy'), to: 'org.deepseek.harness.desktop.update.policy' },
+    { from: resource('RPM-GPG-KEY-dsh-desktop'), to: 'RPM-GPG-KEY-dsh-desktop' },
+  ]
+}
+
+/**
+ * Package sections for the Linux targets. `formats` is present only when this build targets Linux;
+ * the same sections are emitted for every platform because electron-builder ignores the ones it does
+ * not build, and keeping them unconditional keeps the shape stable across platforms.
+ */
+function linuxTargets({ formats, packages }) {
+  return {
+    linux: {
+      // The Linux package ships its own hicolor size set (16-512): the macOS squircle plate reads
+      // poorly in a Linux application grid, and a single PNG only lands at its own pixel size.
+      icon: resource('icons-linux'),
+      category: 'Development',
+      // electron-builder otherwise derives the command from the scoped package name.
+      executableName: 'deepseek-harness',
+      // Electron derives the window app_id from desktopName, and StartupWMClass has to match it for a
+      // desktop environment to associate the running window with this entry.
+      syncDesktopName: true,
+      // fpm writes the synopsis as the Debian Description's first line and as the RPM Summary. Debian
+      // policy requires a nonempty synopsis there, and an unset one leaves that line blank.
+      synopsis: 'DeepSeek Harness desktop application',
+      // productName 是路径安全的 token（/opt 目录跟着它走），菜单里显示的名字在这里单独覆盖。
+      desktop: { entry: { Name: 'DeepSeek Harness' } },
+      // fpm records the maintainer in the Debian control file and the RPM header; AppImage carries none.
+      ...(packages === undefined ? {} : { maintainer: packages.maintainer }),
+      target: formats ?? ['AppImage'],
+    },
+    // The legacy AppImage toolset otherwise writes "Exec=AppRun --no-sandbox %U", which turns off the
+    // Chromium sandbox for every launch from the desktop menu. An explicitly empty argument list keeps
+    // that flag out of the entry and leaves AppRun's own "unshare -Ur true" probe in charge: it adds the
+    // flag only where user namespaces are unavailable. Scoped to this target because the fpm targets
+    // take executableArgs from the linux options, where an empty array would leave a double space in
+    // their Exec line.
+    appImage: { executableArgs: [] },
+    // fpm derives the package name from the scoped package.json name and otherwise falls back to the
+    // product name, which contains a space. The Debian backend silently rewrites that, but rpmbuild
+    // rejects it with "Tag takes single token only", so both formats name the package explicitly.
+    // The category is explicit for the same reason: fpm otherwise stamps Debian's Section and RPM's
+    // Group as "default", which names neither a Debian section nor an RPM group.
+    deb: { packageName: 'dsh-desktop', packageCategory: 'devel' },
+    // The package owns /opt/deepseek-harness-desktop and an ELF payload that must not be touched by
+    // rpmbuild's post-processing: stripping Electron/Node binaries breaks their embedded resources,
+    // and the automatic dependency scanner cannot resolve the bundled shared objects. The dependency
+    // list below therefore states the system libraries the app actually loads, including the two
+    // that are dlopen-only (libdbusmenu-glib for the tray menu, libsecret for the keyring) and that
+    // an rpm autogenerated list would miss.
+    rpm: {
+      packageName: 'dsh-desktop',
+      packageCategory: 'Development/Tools',
+      depends: [
+        'gtk3', 'nss', 'nspr', 'libnotify', 'libXScrnSaver', '(libXtst or libXtst6)', 'xdg-utils',
+        'at-spi2-core', '(libuuid or libuuid1)', 'libsecret', 'libdbusmenu',
+        // Electron 运行时直接 dlopen/链接的系统库。只列 gtk3 一族不够：容器与最小安装里
+        // libgbm/alsa/libxkbcommon 是必查项，缺一个窗口就起不来。
+        'alsa-lib', 'libdrm', 'mesa-libgbm', 'mesa-libGL', 'libxkbcommon', 'cups-libs',
+        'expat', 'glib2', 'pango', 'cairo', 'gdk-pixbuf2', 'dbus-libs', 'systemd-libs',
+        'libX11', 'libXcomposite', 'libXdamage', 'libXext', 'libXfixes', 'libXrandr', 'libxcb',
+        // 应用内更新链直接依赖：helper 执行 `dnf5 upgrade`，安装经 pkexec（polkit）。
+        // 最小安装/纯净容器里缺任一个，更新按钮就是坏的。
+        'dnf5', 'polkit',
+      ],
+      afterInstall: resource('rpm-post-install.sh'),
+      afterRemove: resource('rpm-post-remove.sh'),
+      fpm: [
+        '--rpm-rpmbuild-define', '_build_id_links none',
+        '--rpm-rpmbuild-define', '__os_install_post %{nil}',
+        '--rpm-rpmbuild-define', '__strip /bin/true',
+        '--rpm-rpmbuild-define', '__brp_strip /bin/true',
+        '--rpm-rpmbuild-define', '_binary_payload w19.zstdio',
+        // 更新链的三个系统侧文件交给 rpm 自己拥有（PLAN §3.4）：fpm 的 `源=目标` 形式把
+        // resources 里的文件装到系统路径，卸载/升级由 rpm 处理，%post 不再复制、%postun 不再删。
+        `${resource('dsh-update-helper')}=/usr/libexec/dsh-update-helper`,
+        `${resource('org.deepseek.harness.desktop.update.policy')}=/usr/share/polkit-1/actions/org.deepseek.harness.desktop.update.policy`,
+        `${resource('dsh-desktop.repo')}=/etc/yum.repos.d/dsh-desktop.repo`,
+        // 用户会改镜像地址或 proxy，升级时不能覆盖本地修改。
+        '--config-files', '/etc/yum.repos.d/dsh-desktop.repo',
+        '--rpm-auto-add-directories',
+      ],
+    },
+  }
+}
+
+/**
+ * Adds the Linux package sections and payload entries to a builder config. On other platforms the
+ * config is returned untouched, so Windows and macOS builds never see the Linux resources.
+ */
+export function withLinuxTargets(config, { platform, formats, packages }) {
+  if (platform !== 'linux') return config
+  return {
+    ...config,
+    ...linuxTargets({ formats, packages }),
+    extraResources: [...config.extraResources, ...linuxExtraResources()],
+  }
+}
