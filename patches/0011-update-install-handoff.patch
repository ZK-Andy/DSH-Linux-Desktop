diff --git a/apps/desktop/src/update-install-handoff.ts b/apps/desktop/src/update-install-handoff.ts
new file mode 100644
index 00000000..ae776c2f
--- /dev/null
+++ b/apps/desktop/src/update-install-handoff.ts
@@ -0,0 +1,52 @@
+/**
+ * Install handoff rules for the dnf-only update chain.
+ *
+ * On Linux the polkit helper upgrades the installed rpm while the application keeps running, so
+ * only a successful helper stops the Host; a failed one leaves the running application untouched.
+ * The embedded chain is the opposite: it stops the Host and locks its tasks before installing.
+ * Keeping the rules here lets `main.ts` stay a wiring site.
+ */
+
+import type { LinuxUpdateRuntime } from './linux-updates.ts'
+
+/** The install chain this process runs. */
+export type InstallChain = 'embedded' | 'linux-package'
+
+export interface InstallHandoff {
+  /** The chain these rules belong to; makes the two booleans below self-explanatory. */
+  readonly chain: InstallChain
+  /** Whether the Host must stop (and lock its tasks) before the updater installs. */
+  readonly stopsHost: boolean
+  /** Whether a failed install must release the Host task lock it took. */
+  readonly unlockOnFailure: (updateStoppedHost: boolean) => boolean
+}
+
+/**
+ * Derives the handoff rules from the runtime the wiring site built.
+ *
+ * Taking the runtime instead of a boolean keeps `main.ts` free of an inversion that tests could
+ * not see: the Linux runtime carries `enabled`, the embedded one does not.
+ * @param runtime - Updater runtime returned by `linuxUpdateRuntime`.
+ * @returns Rules for this process's install chain.
+ */
+export function installHandoff(runtime: Pick<LinuxUpdateRuntime, 'enabled'> | undefined): InstallHandoff {
+  if (runtime?.enabled?.() === true) {
+    return { chain: 'linux-package', stopsHost: false, unlockOnFailure: () => false }
+  }
+  return { chain: 'embedded', stopsHost: true, unlockOnFailure: (updateStoppedHost: boolean): boolean => !updateStoppedHost }
+}
+
+export interface LinuxInstallRelaunch {
+  readonly relaunch: () => void
+  readonly quit: () => void
+  readonly isQuitting: () => boolean
+}
+
+/** Restarts the upgraded build after a successful helper run unless the user is already quitting. */
+export function createLinuxInstallRelaunch(deps: LinuxInstallRelaunch): () => void {
+  return () => {
+    if (deps.isQuitting()) return
+    deps.relaunch()
+    deps.quit()
+  }
+}
diff --git a/apps/desktop/tests/update-install-handoff.spec.ts b/apps/desktop/tests/update-install-handoff.spec.ts
new file mode 100644
index 00000000..74f3e446
--- /dev/null
+++ b/apps/desktop/tests/update-install-handoff.spec.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  createLinuxInstallRelaunch, installHandoff,
+} from '../src/update-install-handoff.ts'
+
+describe('install handoff', () => {
+  it('keeps the Host running for the Linux package chain', () => {
+    const handoff = installHandoff({ enabled: () => true })
+    expect(handoff.chain).toBe('linux-package')
+    expect(handoff.stopsHost).toBe(false)
+    expect(handoff.unlockOnFailure(false)).toBe(false)
+    expect(handoff.unlockOnFailure(true)).toBe(false)
+  })
+
+  it('stops the Host and releases its lock for the embedded chain', () => {
+    for (const runtime of [{ enabled: () => false }, {}, undefined]) {
+      const handoff = installHandoff(runtime)
+      expect(handoff.chain).toBe('embedded')
+      expect(handoff.stopsHost).toBe(true)
+      expect(handoff.unlockOnFailure(false)).toBe(true)
+      expect(handoff.unlockOnFailure(true)).toBe(false)
+    }
+  })
+
+  it('relaunches the upgraded build before quitting', () => {
+    const calls: string[] = []
+    const finish = createLinuxInstallRelaunch({
+      relaunch: () => { calls.push('relaunch') },
+      quit: () => { calls.push('quit') },
+      isQuitting: () => false,
+    })
+    finish()
+    expect(calls).toEqual(['relaunch', 'quit'])
+  })
+
+  it('does not restart a build the user is already quitting', () => {
+    const relaunch = vi.fn()
+    const quit = vi.fn()
+    const finish = createLinuxInstallRelaunch({ relaunch, quit, isQuitting: () => true })
+    finish()
+    expect(relaunch).not.toHaveBeenCalled()
+    expect(quit).not.toHaveBeenCalled()
+  })
+})
