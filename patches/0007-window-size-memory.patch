+import { app, screen, type BrowserWindow } from 'electron'
+import { readDesktopSettings, saveDesktopWindowSize } from './settings.ts'
+
+/** Default frameless window size, matching the reference desktop shell. */
+const DEFAULT_WINDOW_WIDTH = 1200
+const DEFAULT_WINDOW_HEIGHT = 800
+/** Floor shared by the BrowserWindow minimum and the restored value. */
+export const MIN_WINDOW_WIDTH = 480
+export const MIN_WINDOW_HEIGHT = 640
+const WINDOW_SIZE_PERSIST_DEBOUNCE_MS = 250
+
+/**
+ * Restored frameless window size, clamped to the primary display's work area.
+ * Maximized stays a separate flag: the normal bounds are what gets persisted.
+ * @returns Initial width and height in DIP and whether to start maximized.
+ */
+export function restoredWindowSize(): { width: number; height: number; maximized: boolean } {
+  const persisted = readDesktopSettings(app.getPath('userData')).desktopWindowSize
+  const { width: areaWidth, height: areaHeight } = screen.getPrimaryDisplay().workAreaSize
+  const clamp = (value: number, minimum: number, available: number): number =>
+    Math.min(Math.max(Math.floor(value), minimum), Math.max(minimum, Math.floor(available)))
+  return {
+    width: clamp(persisted?.width ?? DEFAULT_WINDOW_WIDTH, MIN_WINDOW_WIDTH, areaWidth),
+    height: clamp(persisted?.height ?? DEFAULT_WINDOW_HEIGHT, MIN_WINDOW_HEIGHT, areaHeight),
+    maximized: persisted?.maximized ?? false,
+  }
+}
+
+/**
+ * Persist the normal bounds and the maximized flag once the user settles the
+ * window; the maximized bounds equal the work area and would erase the last
+ * hand-picked size.
+ * @param window - primary window whose geometry is recorded.
+ */
+export function attachWindowSizePersistence(window: BrowserWindow): void {
+  let timer: NodeJS.Timeout | undefined
+  const save = (): void => {
+    if (window.isDestroyed()) return
+    try {
+      const bounds = window.getNormalBounds()
+      saveDesktopWindowSize(app.getPath('userData'), {
+        width: Math.max(MIN_WINDOW_WIDTH, Math.floor(bounds.width)),
+        height: Math.max(MIN_WINDOW_HEIGHT, Math.floor(bounds.height)),
+        maximized: window.isMaximized(),
+      })
+    } catch (error) {
+      console.warn('desktop window size: not persisted', error)
+    }
+  }
+  const schedule = (): void => {
+    if (timer !== undefined) clearTimeout(timer)
+    timer = setTimeout(() => { timer = undefined; save() }, WINDOW_SIZE_PERSIST_DEBOUNCE_MS)
+  }
+  window.on('resize', schedule)
+  window.on('maximize', schedule)
+  window.on('unmaximize', schedule)
+  window.on('close', () => {
+    if (timer !== undefined) { clearTimeout(timer); timer = undefined }
+    save()
+  })
+}
