 import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
 import { join } from 'node:path'
 
+/** Persisted frameless window geometry; absent until the window has been resized. */
+export interface DesktopWindowSize {
+  /** Normal (unmaximized) width in DIP. */
+  readonly width: number
+  /** Normal (unmaximized) height in DIP. */
+  readonly height: number
+  /** Whether the window was maximized when its size was last recorded. */
+  readonly maximized: boolean
+}
+
 /** Resolved shell preferences; absent fields use the defaults without rewriting existing files. */
 export interface DesktopSettings {
   readonly updates: {
     readonly allowTestAuthPopupWindow: boolean
   }
+  readonly desktopWindowSize?: DesktopWindowSize
 }
 
 function record(value: unknown): value is Record<string, unknown> {
   return typeof value === 'object' && value !== null && !Array.isArray(value)
 }
 
+/** Persisted dimensions are whole positive numbers in device-independent pixels. */
+function dimension(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0 ? Math.floor(value) : undefined
+}
+
 /**
  * Read shell settings, creating the default document exclusively when missing.
  * @param userData - Electron's userData directory, independent of DSH_HOME.
@@ -44,7 +60,16 @@ export function readDesktopSettings(userData: string): DesktopSettings {
     if (allow !== undefined && typeof allow !== 'boolean') {
       throw new Error('updates.allowTestAuthPopupWindow must be true or false')
     }
-    return { updates: { allowTestAuthPopupWindow: allow ?? false } }
+    const size = value.desktopWindowSize
+    const updates = { updates: { allowTestAuthPopupWindow: allow ?? false } }
+    if (size === undefined) return updates
+    const width = record(size) ? dimension(size.width) : undefined
+    const height = record(size) ? dimension(size.height) : undefined
+    const maximized = record(size) ? size.maximized : undefined
+    if (width === undefined || height === undefined || typeof maximized !== 'boolean') {
+      throw new Error('desktopWindowSize must carry positive width and height and a boolean maximized')
+    }
+    return { ...updates, desktopWindowSize: { width, height, maximized } }
   } catch (error) {
     try {
       console.warn(`desktop settings: ${path}: using defaults because settings could not be loaded`, error)
@@ -55,3 +80,27 @@ export function readDesktopSettings(userData: string): DesktopSettings {
     return defaults
   }
 }
+
+/**
+ * Persist the frameless window's normal geometry and maximized state, leaving
+ * every other shell preference in the document untouched.
+ * @param userData - Electron's userData directory, independent of DSH_HOME.
+ * @param size - Normal (unmaximized) window dimensions in DIP and the maximized state.
+ */
+export function saveDesktopWindowSize(userData: string, size: DesktopWindowSize): void {
+  const directory = join(userData, 'desktop')
+  const path = join(directory, 'settings.json')
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  let document: Record<string, unknown> = {}
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(path, 'utf8'))
+    if (record(parsed)) document = parsed
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException).code
+    if (code !== 'ENOENT' && !(error instanceof SyntaxError)) throw error
+  }
+  document.desktopWindowSize = {
+    width: Math.floor(size.width), height: Math.floor(size.height), maximized: size.maximized,
+  }
+  writeFileSync(path, `${JSON.stringify(document, null, 2)}\n`, { mode: 0o600 })
+}
