+
+it('round-trips the frameless window size without touching other preferences', () => {
+  const { userData, path } = fixture()
+  writeFileSync(path, '{"updates":{"allowTestAuthPopupWindow":true},"custom":"preserve"}')
+  saveDesktopWindowSize(userData, { width: 1100.7, height: 700, maximized: true })
+  expect(readDesktopSettings(userData).desktopWindowSize).toEqual({ width: 1100, height: 700, maximized: true })
+  const raw = JSON.parse(readFileSync(path, 'utf8')) as Record<string, unknown>
+  expect(raw.custom).toBe('preserve')
+  expect(raw.updates).toEqual({ allowTestAuthPopupWindow: true })
+})
+
+it('ignores a malformed stored window size and reports it', () => {
+  const { userData, path } = fixture()
+  writeFileSync(path, '{"desktopWindowSize":{"width":"1100","height":700,"maximized":false}}')
+  expect(readDesktopSettings(userData).desktopWindowSize).toBeUndefined()
+  expect(console.warn).toHaveBeenCalledWith(expect.stringContaining(path), expect.any(Error))
