+/** Frameless window geometry remembered across launches; the settings document owns storage. */
+import { readFileSync } from 'node:fs'
+import { app, screen, type BrowserWindow } from 'electron'
+import { DesktopSettingsFile } from './settings-file.ts'
+
+/** Root field of the settings document that records the window geometry. */
+const WINDOW_SIZE_FIELD = 'desktopWindowSize'
+/** Default frameless window size, matching the reference desktop shell. */
+const DEFAULT_WINDOW_WIDTH = 1200
+const DEFAULT_WINDOW_HEIGHT = 800
+/** Floor shared by the BrowserWindow minimum and the restored value. */
+export const MIN_WINDOW_WIDTH = 480
+export const MIN_WINDOW_HEIGHT = 640
+const WINDOW_SIZE_PERSIST_DEBOUNCE_MS = 250
+
+/** Persisted frameless window geometry; the normal bounds, not the maximized ones. */
+export interface DesktopWindowSize {
+  readonly width: number
+  readonly height: number
+  readonly maximized: boolean
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+/** Geometry dimensions are whole positive numbers in device-independent pixels. */
+function dimension(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0 ? Math.floor(value) : undefined
+}
+
+/** Validate the window geometry root field; a malformed value is treated as absent. */
+function windowSize(value: unknown): DesktopWindowSize | undefined {
+  if (!record(value)) return undefined
+  const width = dimension(value.width)
+  const height = dimension(value.height)
+  if (width === undefined || height === undefined || typeof value.maximized !== 'boolean') return undefined
+  return { width, height, maximized: value.maximized }
+}
+
+/** Settings document shared with the update-channel preferences. */
+function settingsFile(): DesktopSettingsFile {
+  return new DesktopSettingsFile(app.getPath('userData'))
+}
+
+/**
+ * Read the persisted geometry without creating the settings document, because the
+ * first window is created synchronously.
+ * @returns Validated geometry, or undefined when it is absent or unreadable.
+ */
+function readWindowSize(): DesktopWindowSize | undefined {
+  const path = settingsFile().path
+  let document: unknown
+  try {
+    document = JSON.parse(readFileSync(path, 'utf8'))
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
+      console.warn(`desktop window size: cannot read ${path}; using defaults`, error)
+    }
+    return undefined
+  }
+  if (!record(document) || document[WINDOW_SIZE_FIELD] === undefined) return undefined
+  const size = windowSize(document[WINDOW_SIZE_FIELD])
+  if (size === undefined) {
+    console.warn(`desktop window size: ${path} has no usable ${WINDOW_SIZE_FIELD}; using defaults`)
+  }
+  return size
+}
+
+/**
+ * Restored frameless window size, clamped to the primary display's work area.
+ * Maximized stays a separate flag: the normal bounds are what gets persisted.
+ * @returns Initial width and height in DIP and whether to start maximized.
+ */
+export function restoredWindowSize(): { width: number; height: number; maximized: boolean } {
+  const persisted = readWindowSize()
+  const { width: areaWidth, height: areaHeight } = screen.getPrimaryDisplay().workAreaSize
+  const clamp = (value: number, minimum: number, available: number): number =>
+    Math.min(Math.max(Math.floor(value), minimum), Math.max(minimum, Math.floor(available)))
+  return {
+    width: clamp(persisted?.width ?? DEFAULT_WINDOW_WIDTH, MIN_WINDOW_WIDTH, areaWidth),
+    height: clamp(persisted?.height ?? DEFAULT_WINDOW_HEIGHT, MIN_WINDOW_HEIGHT, areaHeight),
+    maximized: persisted?.maximized ?? false,
+  }
+}
+
+/**
+ * Persist the normal bounds and the maximized flag; the maximized bounds equal
+ * the work area and would erase the last hand-picked size. Writes go through the
+ * settings document so an unrelated preference change is never lost.
+ * @param window - primary window whose geometry is recorded.
+ */
+export async function persistWindowSize(window: BrowserWindow): Promise<void> {
+  if (window.isDestroyed()) return
+  let bounds: Electron.Rectangle
+  try {
+    bounds = window.getNormalBounds()
+  } catch (error) {
+    console.warn('desktop window size: no normal bounds to record', error)
+    return
+  }
+  const size: DesktopWindowSize = {
+    width: Math.max(MIN_WINDOW_WIDTH, Math.floor(bounds.width)),
+    height: Math.max(MIN_WINDOW_HEIGHT, Math.floor(bounds.height)),
+    maximized: window.isMaximized(),
+  }
+  await settingsFile().saveRoot({ [WINDOW_SIZE_FIELD]: size })
+}
+
+/**
+ * Persist the window geometry once the user settles the window.
+ * @param window - primary window whose geometry is recorded.
+ */
+export function attachWindowSizePersistence(window: BrowserWindow): void {
+  let timer: NodeJS.Timeout | undefined
+  const save = (): void => {
+    void persistWindowSize(window).catch((error: unknown) => {
+      console.warn('desktop window size: not persisted', error)
+    })
+  }
+  const schedule = (): void => {
+    if (timer !== undefined) clearTimeout(timer)
+    timer = setTimeout(() => { timer = undefined; save() }, WINDOW_SIZE_PERSIST_DEBOUNCE_MS)
+  }
+  window.on('resize', schedule)
+  window.on('maximize', schedule)
+  window.on('unmaximize', schedule)
+  window.on('close', () => {
+    if (timer !== undefined) { clearTimeout(timer); timer = undefined }
+    save()
+  })
+}
