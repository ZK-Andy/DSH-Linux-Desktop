diff --git a/apps/desktop/tests/linux-window-size.spec.ts b/apps/desktop/tests/linux-window-size.spec.ts
new file mode 100644
index 00000000..ffaafab3
--- /dev/null
+++ b/apps/desktop/tests/linux-window-size.spec.ts
@@ -0,0 +1,119 @@
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { afterEach, beforeEach, expect, it, onTestFinished, vi } from 'vitest'
+import type { BrowserWindow } from 'electron'
+import { MIN_WINDOW_HEIGHT, MIN_WINDOW_WIDTH, attachWindowSizePersistence, persistWindowSize, restoredWindowSize } from '../src/linux-window-size.ts'
+
+const state = vi.hoisted(() => ({ userData: '' }))
+
+vi.mock('electron', () => ({
+  app: { getPath: (name: string) => (name === 'userData' ? state.userData : '') },
+  screen: { getPrimaryDisplay: () => ({ workAreaSize: { width: 1920, height: 1080 } }) },
+}))
+
+/** Point the app's userData at a fresh directory and optionally seed the settings document. */
+function fixture(raw?: string): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-desktop-window-size-'))
+  onTestFinished(() => rmSync(root, { recursive: true, force: true }))
+  state.userData = root
+  const path = join(root, 'desktop', 'settings.json')
+  if (raw !== undefined) {
+    mkdirSync(dirname(path))
+    writeFileSync(path, raw)
+  }
+  return path
+}
+
+interface FakeWindow {
+  readonly window: BrowserWindow
+  readonly bounds: { width: number; height: number }
+  readonly emit: (name: string) => void
+}
+
+/** Minimal BrowserWindow double: only the geometry surface the module touches. */
+function fakeWindow(options: { width: number; height: number; maximized?: boolean }): FakeWindow {
+  const handlers = new Map<string, () => void>()
+  const bounds = { width: options.width, height: options.height }
+  const window = {
+    isDestroyed: () => false,
+    isMaximized: () => options.maximized ?? false,
+    getNormalBounds: () => ({ x: 0, y: 0, ...bounds }),
+    on: (name: string, handler: () => void) => { handlers.set(name, handler) },
+  }
+  return { window: window as unknown as BrowserWindow, bounds, emit: (name: string) => { handlers.get(name)?.() } }
+}
+
+beforeEach(() => { vi.spyOn(console, 'warn').mockImplementation(() => {}) })
+afterEach(() => { vi.restoreAllMocks() })
+
+it('restores the default size when no geometry was stored', () => {
+  fixture()
+  expect(restoredWindowSize()).toEqual({ width: 1200, height: 800, maximized: false })
+  expect(console.warn).not.toHaveBeenCalled()
+})
+
+it('clamps stored geometry to the window minimum and the work area', () => {
+  fixture('{"desktopWindowSize":{"width":400,"height":5000,"maximized":true}}')
+  expect(restoredWindowSize()).toEqual({ width: MIN_WINDOW_WIDTH, height: 1080, maximized: true })
+})
+
+it('falls back to the default size and reports a malformed root field', () => {
+  const path = fixture('{"desktopWindowSize":{"width":"400","height":900,"maximized":true}}')
+  expect(restoredWindowSize()).toEqual({ width: 1200, height: 800, maximized: false })
+  expect(console.warn).toHaveBeenCalledWith(expect.stringContaining(path))
+})
+
+it('falls back to the default size and reports an unreadable document', () => {
+  fixture('{not json')
+  expect(restoredWindowSize()).toEqual({ width: 1200, height: 800, maximized: false })
+  expect(console.warn).toHaveBeenCalledWith(expect.stringContaining('cannot read'), expect.anything())
+})
+
+it('persists normal bounds without disturbing unrelated settings', async () => {
+  const path = fixture('{"custom":{"kept":true},"updates":{"allowTestAuthPopupWindow":true,"channel":"stable"}}')
+  await persistWindowSize(fakeWindow({ width: 1100.7, height: 700, maximized: true }).window)
+  expect(JSON.parse(readFileSync(path, 'utf8'))).toEqual({
+    custom: { kept: true },
+    updates: { allowTestAuthPopupWindow: true, channel: 'stable' },
+    desktopWindowSize: { width: 1100, height: 700, maximized: true },
+  })
+  expect(restoredWindowSize()).toEqual({ width: 1100, height: 700, maximized: true })
+})
+
+it('never persists geometry below the window minimum', async () => {
+  const path = fixture()
+  await persistWindowSize(fakeWindow({ width: 100, height: 120 }).window)
+  expect(JSON.parse(readFileSync(path, 'utf8')).desktopWindowSize).toEqual({
+    width: MIN_WINDOW_WIDTH, height: MIN_WINDOW_HEIGHT, maximized: false,
+  })
+})
+
+it('records nothing once the window is destroyed', async () => {
+  const path = fixture()
+  await persistWindowSize({ isDestroyed: () => true } as unknown as BrowserWindow)
+  expect(() => readFileSync(path, 'utf8')).toThrow()
+})
+
+it('refuses to rewrite a malformed document', async () => {
+  const path = fixture('{secret-value')
+  await expect(persistWindowSize(fakeWindow({ width: 900, height: 700 }).window)).rejects.toMatchObject({
+    problem: { kind: 'invalid', reason: 'json' },
+  })
+  expect(readFileSync(path, 'utf8')).toBe('{secret-value')
+})
+
+it('persists when the window settles and when it closes', async () => {
+  const path = fixture()
+  const { window, bounds, emit } = fakeWindow({ width: 900, height: 700 })
+  attachWindowSizePersistence(window)
+  emit('resize')
+  await vi.waitFor(() => {
+    expect(JSON.parse(readFileSync(path, 'utf8')).desktopWindowSize).toEqual({ width: 900, height: 700, maximized: false })
+  })
+  bounds.width = 1000
+  emit('close')
+  await vi.waitFor(() => {
+    expect(JSON.parse(readFileSync(path, 'utf8')).desktopWindowSize).toMatchObject({ width: 1000 })
+  })
+})
