+#!/bin/bash
+# RPM scriptlet: runs as root on install ($1 = 1) and upgrade ($1 = 2).
+set -e
+
+app_dir="/opt/${productFilename}"
+sandbox="$app_dir/chrome-sandbox"
+
+# Fedora enables unprivileged user namespaces, in which case Chromium's setuid helper must not be
+# setuid. Only fall back to 4755 where user namespaces are unavailable.
+if [ -e "$sandbox" ]; then
+  if [ -L /proc/self/ns/user ] && unshare --user true 2>/dev/null; then
+    chmod 0755 "$sandbox"
+  else
+    chmod 4755 "$sandbox"
+  fi
+fi
+
+if command -v update-desktop-database >/dev/null 2>&1; then
+  update-desktop-database -q /usr/share/applications || true
+fi
+if command -v gtk-update-icon-cache >/dev/null 2>&1; then
+  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
+fi
