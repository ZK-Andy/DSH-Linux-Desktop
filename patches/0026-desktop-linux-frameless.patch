+/**
+ * Linux frameless primary window: the document marks itself as caption-less and
+ * the application renders the window controls (ui-layout's WindowControls), so
+ * the native titlebar adds nothing.
+ *
+ * The window is opaque. A transparent window would let the compositor round the
+ * corners against the desktop, but transparency on Wayland costs a per-frame
+ * alpha composite of the whole window and has been the least reliable part of
+ * Electron's Linux window support; the panel is therefore painted by the client
+ * bundles at full window size. This module supplies the document marker; the
+ * preload supplies the product API the page drives the window with.
+ */
+
+/** Preload argument marking the application document as a frameless Linux window. */
+export const FRAME_ARGUMENT = '--dsh-desktop-frame'
+
+/** Whether the primary window draws its own frame: every Linux desktop build does. */
+export function desktopFrameless(): boolean {
+  return process.platform === 'linux'
+}
+
+/**
+ * Markup injected into the application Web document before its own bundles run.
+ * The document keeps no panel paint of its own: the client bundles fill the whole
+ * window. The shell marks which control seat the active panel uses; panels with a
+ * header row seat the controls inline, chrome-less panels keep the floating seat,
+ * and only the floating seat needs header rows kept clear of it.
+ * @returns Markup for the document head.
+ */
+export function frameDocument(): string {
+  return `<script>document.documentElement.setAttribute('data-desktop-frame','');document.documentElement.dataset.desktopControls='header'</script>
+<style>
+html[data-desktop-controls='overlay'] header[data-window-drag] { padding-right: 112px; }
+</style>`
+}
