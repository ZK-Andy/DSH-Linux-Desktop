diff --git a/apps/desktop/src/preload-linux-frame.ts b/apps/desktop/src/preload-linux-frame.ts
new file mode 100644
index 0000000..1ce77a5
--- /dev/null
+++ b/apps/desktop/src/preload-linux-frame.ts
@@ -0,0 +1,59 @@
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC } from './ipc.ts'
+
+/** Window actions the frameless Linux title band delegates to the main process. */
+type WindowAction = 'minimize' | 'toggle-maximize' | 'close'
+
+/** Glyph per button; the maximize button swaps its glyph with the window state. */
+const GLYPHS = {
+  minimize: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 8h9"/></svg>',
+  maximize: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1.5"/></svg>',
+  restore: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3.5" y="6" width="6.5" height="6.5" rx="1.5"/><path d="M6.5 4.5h5a1 1 0 0 1 1 1v5"/></svg>',
+  close: '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>',
+} as const
+
+/** One control button; the close button borrows the destructive hover paint. */
+function button(action: WindowAction, label: string, glyph: string): HTMLButtonElement {
+  const element = document.createElement('button')
+  element.type = 'button'
+  element.dataset.action = action
+  element.setAttribute('aria-label', label)
+  element.title = label
+  element.innerHTML = glyph
+  element.addEventListener('click', () => { void ipcRenderer.invoke(DESKTOP_IPC.windowAction, action) })
+  return element
+}
+
+/**
+ * Draws the window controls for a frameless Linux window and keeps the
+ * maximize glyph in step with the main process.
+ *
+ * The band is shell-owned DOM appended after the application root: it never
+ * participates in the client layout, and its buttons subtract themselves from
+ * the window drag surface through the injected stylesheet.
+ */
+export function installLinuxFrame(): void {
+  const install = (): void => {
+    const root = document.documentElement
+    if (root === null) return
+    root.setAttribute('data-desktop-frame', '')
+    if (document.getElementById('dsh-window-controls') !== null) return
+    const band = document.createElement('div')
+    band.id = 'dsh-window-controls'
+    const maximize = button('toggle-maximize', 'Maximize', GLYPHS.maximize)
+    band.append(
+      button('minimize', 'Minimize', GLYPHS.minimize),
+      maximize,
+      button('close', 'Close', GLYPHS.close),
+    )
+    document.body.append(band)
+    ipcRenderer.on(DESKTOP_IPC.windowState, (_event, maximized: boolean) => {
+      maximize.innerHTML = maximized ? GLYPHS.restore : GLYPHS.maximize
+      const label = maximized ? 'Restore' : 'Maximize'
+      maximize.setAttribute('aria-label', label)
+      maximize.title = label
+    })
+  }
+  if (document.readyState === 'loading') window.addEventListener('DOMContentLoaded', install, { once: true })
+  else install()
+}
