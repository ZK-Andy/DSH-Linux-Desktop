+    if (window.isDestroyed()) return
+    try {
+      const bounds = window.getNormalBounds()
+      saveDesktopWindowSize(app.getPath('userData'), {
+        width: Math.max(MIN_WINDOW_WIDTH, Math.floor(bounds.width)),
+        height: Math.max(MIN_WINDOW_HEIGHT, Math.floor(bounds.height)),
+        maximized: window.isMaximized(),
+      })
+    } catch (error) {
+      console.warn('desktop window size: not persisted', error)
+    }
+  }
+  const schedule = (): void => {
