new file mode 100644
index 0000000..340c4a1
--- /dev/null
+++ b/apps/desktop/src/update-feed.ts
@@ -0,0 +1,89 @@
+/**
+ * Linux update feed: the release asset `version.json` published next to the signed rpm.
+ *
+ * The electron-updater feed is replaced on Linux because the installer is the package manager:
+ * a release is one signed rpm and one JSON manifest describing it. Everything here is pure so the
+ * parser and the comparison can be unit-tested without Electron or the network.
+ */
+
+/** Where a packaged Linux build looks for the newest release manifest. */
+export const LINUX_UPDATE_FEED_URL = 'https://github.com/ZK-Andy/DSH-Linux-Desktop/releases/latest/download/version.json'
+
+/** One published release, validated field by field before any download is allowed. */
+export interface DesktopReleaseFeed {
+  /** semver-comparable form used by the update coordinator (0.2.2-alpha.2.2). */
+  readonly version: string
+  /** Published tag (v0.2.2-alpha.2-2). */
+  readonly tag: string
+  readonly rpmVersion: string
+  readonly rpmRelease: string
+  readonly package: string
+  readonly sha256: string
+  readonly bytes: number
+  readonly publishedAt?: string
+  readonly signingKeyId?: string
+}
+
+const PACKAGE_NAME = /^dsh-desktop-[0-9A-Za-z.~+_-]+\.rpm$/
+const SHA256 = /^[0-9a-f]{64}$/
+const SEMVER = /^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/
+
+class FeedFieldError extends Error {
+  readonly field: string
+
+  constructor(field: string, detail: string) {
+    super(`更新清单的 ${field} 不可信：${detail}`)
+    this.field = field
+  }
+}
+
+const text = (value: unknown, field: string, pattern?: RegExp): string => {
+  if (typeof value !== 'string' || value.length === 0) throw new FeedFieldError(field, '不是非空字符串')
+  if (pattern !== undefined && !pattern.test(value)) throw new FeedFieldError(field, `格式不匹配：${value}`)
+  return value
+}
+
+/**
+ * @param value - Parsed JSON from the release asset.
+ * @returns The manifest with every field narrowed.
+ * @throws FeedFieldError when a field is missing or malformed; the caller reports it instead of downloading.
+ */
+export function parseReleaseFeed(value: unknown): DesktopReleaseFeed {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new FeedFieldError('根', '不是对象')
+  const record = value as Record<string, unknown>
+  const bytes = record.bytes
+  if (typeof bytes !== 'number' || !Number.isInteger(bytes) || bytes <= 0) throw new FeedFieldError('bytes', '不是正整数')
+  const publishedAt = record.publishedAt
+  const signingKeyId = record.signingKeyId
+  const version = text(record.version, 'version', SEMVER)
+  // The release must ride in a numeric segment (…alpha.2.2); a tag-style …alpha.2-2 would compare
+  // wrong the moment the release reaches two digits.
+  if (!/\.\d+$/.test(version)) throw new FeedFieldError('version', `缺少数值打包号：${version}`)
+  return {
+    version,
+    tag: text(record.tag, 'tag', /^v\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?-\d+$/),
+    rpmVersion: text(record.rpmVersion, 'rpmVersion'),
+    rpmRelease: text(record.rpmRelease, 'rpmRelease', /^\d+$/),
+    package: text(record.package, 'package', PACKAGE_NAME),
+    sha256: text(record.sha256, 'sha256', SHA256),
+    bytes,
+    ...(typeof publishedAt === 'string' && publishedAt.length > 0 ? { publishedAt } : {}),
+    ...(typeof signingKeyId === 'string' && signingKeyId.length > 0 ? { signingKeyId } : {}),
+  }
+}
+
+/**
+ * @param url - Manifest URL.
+ * @param timeoutMs - Abort budget for the whole request.
+ * @returns The validated manifest.
+ * @throws Error with the HTTP status or parse failure; callers surface it as a check failure.
+ */
+export async function fetchReleaseFeed(url: string, timeoutMs: number): Promise<DesktopReleaseFeed> {
+  const response = await fetch(url, {
+    redirect: 'follow',
+    headers: { accept: 'application/json' },
+    signal: AbortSignal.timeout(timeoutMs),
+  })
+  if (!response.ok) throw new Error(`更新清单请求失败：HTTP ${response.status}`)
+  return parseReleaseFeed(await response.json())
+}
diff --git a/apps/desktop/src/update-linux.ts b/apps/desktop/src/update-linux.ts
