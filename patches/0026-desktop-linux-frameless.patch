+import { createHash } from 'node:crypto'
+import { mkdtemp, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { DesktopReleaseFeed } from '../src/update-feed.ts'
+import { downloadRelease, releaseAssetUrl } from '../src/update-download.ts'
+
+const body = Buffer.from('signed rpm bytes')
+const feed: DesktopReleaseFeed = {
+  version: '0.2.2-alpha.2.2',
+  tag: 'v0.2.2-alpha.2-2',
+  rpmVersion: '0.2.2~alpha.2',
+  rpmRelease: '2',
+  package: 'dsh-desktop-0.2.2-alpha.2-x86_64.rpm',
+  sha256: createHash('sha256').update(body).digest('hex'),
+  bytes: body.length,
+}
+
+const dirs: string[] = []
+async function cacheDir(): Promise<string> {
+  const dir = await mkdtemp(join(tmpdir(), 'dsh-update-test-'))
+  dirs.push(dir)
+  return dir
+}
+
+afterEach(async () => {
+  vi.unstubAllGlobals()
+  await Promise.all(dirs.splice(0).map(async dir => rm(dir, { recursive: true, force: true })))
+})
+
+function stubFetch(payload: Buffer, status = 200, length = payload.length) {
+  // Buffer is a view over ArrayBufferLike; Response wants an ArrayBuffer of its own.
+  const bytes = payload.buffer.slice(payload.byteOffset, payload.byteOffset + payload.byteLength) as ArrayBuffer
+  const fetchMock = vi.fn(async () => new Response(bytes, {
+    status,
+    headers: length > 0 ? { 'content-length': String(length) } : {},
+  }))
+  vi.stubGlobal('fetch', fetchMock)
+  return fetchMock
+}
+
+it('points at the asset of the published tag', () => {
+  expect(releaseAssetUrl(feed)).toBe(`https://github.com/ZK-Andy/DSH-Linux-Desktop/releases/download/${feed.tag}/${feed.package}`)
+})
+
+it('downloads, hashes and reuses the package', async () => {
+  const dir = await cacheDir()
+  const fetchMock = stubFetch(body)
+  const progress: number[] = []
+  const path = await downloadRelease(dir, feed, percent => progress.push(percent))
+  expect(await readFile(path)).toEqual(body)
+  expect(progress.at(-1)).toBe(100)
+  expect(fetchMock).toHaveBeenCalledTimes(1)
+
+  const again = await downloadRelease(dir, feed, () => undefined)
+  expect(again).toBe(path)
+  expect(fetchMock).toHaveBeenCalledTimes(1)
+})
+
+it('deletes a payload whose digest does not match the manifest', async () => {
