@@ -0,0 +1,44 @@
+/* Frameless window controls: the same 28px band the preload used to draw, now
+   rendered by the page over the product API. */
+.controls {
+  display: flex;
+  gap: 2px;
+  -webkit-app-region: no-drag;
+}
+
+/* Chrome-less seat: panels without a header row keep the controls floating over
+   their top-right corner (ZCode DesktopOverlayWindowControls right-1 top-1). */
+.overlay {
+  position: fixed;
+  top: 11px;
+  right: 16px;
+  z-index: 30;
+}
+
+/* Only one of the two seats is live: the shell marks which one the active panel
+   uses (main panel id === 'conversation' has a header row). */
+:global(html[data-desktop-controls='header']) .overlay {
+  display: none;
+}
+
+.control {
+  box-sizing: border-box;
+  display: grid;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+}
+
+.control:hover {
+  background: color-mix(in srgb, var(--dsw-alias-label-primary) 10%, transparent);
+}
+
+.close:hover {
+  background: #e5484d;
+  color: #fff;
+}
diff --git a/packages/client/ui-layout/src/client/WindowControls.tsx b/packages/client/ui-layout/src/client/WindowControls.tsx
new file mode 100644
index 0000000..8e090bc
--- /dev/null
+++ b/packages/client/ui-layout/src/client/WindowControls.tsx
@@ -0,0 +1,96 @@
+/**
+ * Linux frameless window controls: the page renders the three buttons and the
+ * product API drives the main process (ZCode renders DesktopWindowControls and
+ * dispatches DesktopCommandIds; this is the same split — renderer owns the
+ * control, main owns the window). The band only exists when the preload marked
+ * the document as a frameless desktop frame.
+ */
+import { useEffect, useState } from 'react'
+import type { ReactElement } from 'react'
+import css from './WindowControls.module.css'
+
+/** Snapshot of the frameless window's chrome state. */
+interface WindowState {
+  maximized: boolean
+  fullscreen: boolean
+}
+
+/** Window-controls surface exposed on `window.dshDesktop` by the preload. */
+interface WindowControlsApi {
+  minimize(): Promise<void>
+  toggleMaximize(): Promise<void>
+  close(): Promise<void>
+  state(): Promise<WindowState>
+  subscribe(listener: (state: WindowState) => void): () => void
+}
+
+function windowControls(): WindowControlsApi | undefined {
+  return (globalThis as typeof globalThis & { dshDesktop?: { windowControls?: WindowControlsApi } })
+    .dshDesktop?.windowControls
+}
+
+/** Window state changes arrive from the main process; the icon swaps with them.
+ * `overlay` is the chrome-less seat for panels that own no header row (the
+ * counterpart of ZCode's DesktopOverlayWindowControls); header panels mount the
+ * inline seat instead and CSS picks whichever the active panel needs. */
+export function WindowControls({ overlay = false }: { readonly overlay?: boolean } = {}): ReactElement | null {
+  const [api] = useState(windowControls)
+  const [maximized, setMaximized] = useState(false)
+  useEffect(() => {
+    if (api === undefined) return
+    let live = true
+    void api.state().then((state) => { if (live) setMaximized(state.maximized) })
+    const unsubscribe = api.subscribe((state) => setMaximized(state.maximized))
+    return () => {
+      live = false
+      unsubscribe()
+    }
+  }, [api])
+  if (api === undefined) return null
+  return (
+    <div className={overlay ? `${css.controls} ${css.overlay}` : css.controls}>
+      <button
+        type="button"
+        className={css.control}
+        aria-label="Minimize window"
+        title="Minimize window"
+        onClick={() => { void api.minimize() }}
+      >
+        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" aria-hidden="true">
+          <path d="M3.5 8h9" />
+        </svg>
+      </button>
+      <button
+        type="button"
+        className={css.control}
+        aria-label={maximized ? 'Restore window' : 'Maximize window'}
+        title={maximized ? 'Restore window' : 'Maximize window'}
+        onClick={() => { void api.toggleMaximize() }}
+      >
+        {maximized
+          ? (
+            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.2" aria-hidden="true">
+              <rect x="3.5" y="6" width="6.5" height="6.5" rx="1.5" />
+              <path d="M6.5 4.5h5a1 1 0 0 1 1 1v5" />
+            </svg>
+          )
+          : (
+            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.2" aria-hidden="true">
+              <rect x="4" y="4" width="8" height="8" rx="1.5" />
+            </svg>
+          )}
+      </button>
+      <button
+        type="button"
+        className={`${css.control} ${css.close}`}
+        aria-label="Close window"
+        title="Close window"
+        onClick={() => { void api.close() }}
+      >
+        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" aria-hidden="true">
+          <path d="M4.5 4.5l7 7M11.5 4.5l-7 7" />
+        </svg>
+      </button>
+    </div>
+  )
+}
