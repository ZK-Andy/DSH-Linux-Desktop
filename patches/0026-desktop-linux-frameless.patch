+ * Maximized stays a separate flag: the normal bounds are what gets persisted.
+ * @returns Initial width and height in DIP and whether to start maximized.
+ */
+function restoredWindowSize(): { width: number; height: number; maximized: boolean } {
+  const persisted = readDesktopSettings(app.getPath('userData')).desktopWindowSize
+  const { width: areaWidth, height: areaHeight } = screen.getPrimaryDisplay().workAreaSize
+  const clamp = (value: number, minimum: number, available: number): number =>
+    Math.min(Math.max(Math.floor(value), minimum), Math.max(minimum, Math.floor(available)))
+  return {
+    width: clamp(persisted?.width ?? DEFAULT_WINDOW_WIDTH, MIN_WINDOW_WIDTH, areaWidth),
+    height: clamp(persisted?.height ?? DEFAULT_WINDOW_HEIGHT, MIN_WINDOW_HEIGHT, areaHeight),
+    maximized: persisted?.maximized ?? false,
