@@ -0,0 +1,159 @@
+/**
+ * Linux package updater: the electron-updater surface the coordinator needs, backed by the
+ * release manifest and the system package manager instead of an embedded installer.
+ *
+ * Only three methods are consumed by DesktopUpdateCoordinator: checkForUpdates, downloadUpdate and
+ * quitAndInstall. Installation never happens in this process: a polkit-authorized helper runs
+ * `dnf5 install` on the verified rpm, and the application relaunches after the helper succeeds.
+ */
+import { EventEmitter } from 'node:events'
+import { execFile, execFileSync } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+import { app } from 'electron'
+import { fetchReleaseFeed, type DesktopReleaseFeed } from './update-feed.ts'
+import { downloadRelease, verifySignedPackage } from './update-download.ts'
+
+const run = promisify(execFile)
+
+/** Shape returned by checkForUpdates; mirrors the fields the coordinator reads. */
+interface LinuxCheckResult {
+  readonly updateInfo: { readonly version: string }
+  readonly isUpdateAvailable: boolean
+}
+
+export interface LinuxUpdaterOptions {
+  /** Published manifest URL. */
+  readonly feedUrl: string
+  /** Cache directory for downloaded packages. */
+  readonly cacheDir: string
+  /** Public key shipped next to the application; undefined outside a packaged app. */
+  readonly keyPath?: string
+  /** Installed polkit helper; its absence disables the update stack. */
+  readonly helperPath?: string
+  /** Request budget for the manifest and the package. */
+  readonly timeoutMs?: number
+  /** Relaunch after a successful install; overridable for tests. */
+  readonly relaunch?: () => void
+}
+
+/**
+ * @returns The Release segment of the installed rpm, or undefined when the rpm database cannot be queried.
+ */
+export async function installedRpmRelease(): Promise<string | undefined> {
+  try {
+    const { stdout } = await run('rpm', ['-q', '--qf', '%{RELEASE}', 'dsh-desktop'], { encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' } })
+    const value = stdout.trim()
+    return /^\d+$/.test(value) ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** Sync variant for the coordinator's `currentVersion` provider; the rpm query is a single local read. */
+export function installedRpmReleaseSync(): string | undefined {
+  try {
+    const value = execFileSync('rpm', ['-q', '--qf', '%{RELEASE}', 'dsh-desktop'], {
+      encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' },
+    }).trim()
+    return /^\d+$/.test(value) ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** electron's getPath has no 'cache' key in this typings version; XDG wins, then ~/.cache. */
+export function defaultCacheDir(): string {
+  const xdg = process.env.XDG_CACHE_HOME
+  return join(xdg !== undefined && xdg.length > 0 ? xdg : join(homedir(), '.cache'), 'dsh-desktop')
+}
+
+export class LinuxPackageUpdater extends EventEmitter {
+  autoDownload = false
+  autoInstallOnAppQuit = false
+  channel = 'nightly'
+  allowPrerelease = true
+  allowDowngrade = false
+
+  private feed: DesktopReleaseFeed | undefined
+  private packagePath: string | undefined
+
+  private readonly options: LinuxUpdaterOptions
+
+  constructor(options: LinuxUpdaterOptions) {
+    super()
+    this.options = options
+  }
+
+  /** @returns Whether the helper this stack depends on is installed. */
+  available(): boolean {
+    const helper = this.options.helperPath
+    return helper !== undefined && existsSync(helper)
+  }
+
+  /**
+   * @returns The published release; the coordinator decides whether it is newer than this build.
+   * @throws When the manifest cannot be fetched or validated.
+   */
+  async checkForUpdates(): Promise<LinuxCheckResult> {
+    const feed = await fetchReleaseFeed(this.options.feedUrl, this.options.timeoutMs ?? 20_000)
+    this.feed = feed
+    return { updateInfo: { version: feed.version }, isUpdateAvailable: true }
+  }
+
+  /**
+   * Downloads and verifies the checked release.
+   * @throws When no check ran, the hash does not match, or the signature is invalid.
+   */
+  async downloadUpdate(): Promise<void> {
+    const feed = this.feed
+    if (feed === undefined) throw new Error('desktop update: 没有已检查的更新')
+    const path = await downloadRelease(this.options.cacheDir, feed, (percent) => {
+      this.emit('download-progress', { percent, transferred: 0, total: feed.bytes, bytesPerSecond: 0 })
+    })
+    const keyPath = this.options.keyPath
+    if (keyPath === undefined) throw new Error('desktop update: 没有随包签名公钥')
+    if (!await verifySignedPackage(path, keyPath)) {
+      throw new Error('desktop update: 更新包签名校验未通过')
+    }
+    this.packagePath = path
+    this.emit('update-downloaded', { version: feed.version })
+  }
+
+  /**
+   * Hands the verified package to the polkit helper, then relaunches on success.
+   * Errors after this point are emitted rather than thrown; the caller has already returned.
+   */
+  quitAndInstall(): void {
+    const path = this.packagePath
+    if (path === undefined) {
+      this.emit('error', new Error('desktop update: 没有已下载的更新包'))
+      return
+    }
+    const helper = this.options.helperPath
+    if (helper === undefined) {
+      this.emit('error', new Error('desktop update: 没有 polkit helper'))
+      return
+    }
+    const child = execFile('pkexec', [helper, path], (error) => {
+      if (error !== null) {
+        this.emit('error', new Error(`desktop update: 安装失败：${error.message}`))
+        return
+      }
+      this.emit('installed', { version: this.feed?.version, path })
+      if (this.options.relaunch !== undefined) this.options.relaunch()
+      else {
+        app.relaunch()
+        app.exit(0)
+      }
+    })
+    child.on('error', (error) => { this.emit('error', error) })
+  }
+
+  /** @returns Cache path used by this instance; exposed for the CI upgrade case. */
+  static cacheDirectory(): string {
+    return defaultCacheDir()
+  }
+}
