@@ -0,0 +1,86 @@
+/**
+ * Linux frameless primary window: the document carries an inset panel and the
+ * preload draws the window controls, so the native titlebar adds nothing.
+ *
+ * The layout reuses the Web layout DSH already ships for a caption-less window
+ * (zero-width sidebar collapse, shell.leading seat, 48px top clearance); this
+ * document only supplies the panel frame the compositor cannot draw on its
+ * own: a transparent window that paints a rounded, 1px-bordered surface inset
+ * by four pixels. Window controls are ordinary DOM buttons in the top-right
+ * chrome band, wired to the main process over the windowAction channel.
+ */
+
+/** Preload argument marking the application document as a frameless Linux window. */
+export const FRAME_ARGUMENT = '--dsh-desktop-frame'
+
+/** Whether the primary window draws its own frame: every Linux desktop build does. */
+export function desktopFrameless(): boolean {
+  return process.platform === 'linux'
+}
+
+/**
+ * Markup injected into the application Web document before its own bundles run.
+ * The transparent host document and the inset panel are the only paint the
+ * window keeps outside the client bundles; the control buttons themselves are
+ * created by the preload so their clicks never reach page code.
+ * @returns Markup for the document head.
+ */
+export function frameDocument(): string {
+  return `<script>document.documentElement.setAttribute('data-desktop-frame','')</script>
+<style>
+/* Transparent host document; the inset panel below is the only opaque surface. */
+html[data-desktop-frame],
+html[data-desktop-frame] body {
+  background: transparent !important;
+}
+html[data-desktop-frame] body { isolation: isolate; }
+
+/* The window's own surface: four pixels of transparent gutter expose the
+   compositor's rounded corners, and the inset ring reads as a window border
+   without adding a layout box. */
+html[data-desktop-frame] #root {
+  box-sizing: border-box;
+  height: calc(100% - 8px);
+  margin: 4px;
+  border-radius: 12px;
+  overflow: hidden;
+  background: var(--dsw-alias-bg-base);
+  box-shadow: inset 0 0 0 1px var(--dsw-alias-border-l3, rgb(0 0 0 / 0.12));
+}
+
+/* Window controls occupy the top-right band; chrome rows that end there keep
+   their actions clear of it. */
+html[data-desktop-frame] header[data-window-drag] { padding-right: 112px; }
+
+#dsh-window-controls {
+  position: fixed;
+  top: 11px;
+  right: 16px;
+  z-index: 2147483000;
+  display: flex;
+  gap: 4px;
+  -webkit-app-region: no-drag;
+}
+#dsh-window-controls button {
+  box-sizing: border-box;
+  display: grid;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+}
+#dsh-window-controls button:hover {
+  background: color-mix(in srgb, var(--dsw-alias-label-primary) 10%, transparent);
+}
+#dsh-window-controls button[data-action='close']:hover {
+  background: #e5484d;
+  color: #fff;
+}
+html[data-fullscreen] #dsh-window-controls { display: none; }
+html[data-fullscreen] header[data-window-drag] { padding-right: 28px; }
+</style>`
+}
