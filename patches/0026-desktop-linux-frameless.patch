+#!/bin/sh
+# rpm %post：把 polkit helper 与策略装到系统位置。helper 只被 pkexec 调用，应用自己不改 /usr。
+set -eu
+
+RESOURCES=/opt/deepseek-harness-desktop/resources
+
+install -d -m 0755 /usr/libexec
+install -d -m 0755 /usr/share/polkit-1/actions
+
+if [ -f "$RESOURCES/dsh-update-helper" ]; then
+  install -m 0755 "$RESOURCES/dsh-update-helper" /usr/libexec/dsh-update-helper
+fi
+
+if [ -f "$RESOURCES/org.deepseek.harness.desktop.update.policy" ]; then
+  install -m 0644 "$RESOURCES/org.deepseek.harness.desktop.update.policy" \
+    /usr/share/polkit-1/actions/org.deepseek.harness.desktop.update.policy
+fi
+
+exit 0
