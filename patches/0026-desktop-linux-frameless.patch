+  window.on('resize', schedule)
+  window.on('maximize', schedule)
+  window.on('unmaximize', schedule)
+  window.on('close', () => {
+    if (timer !== undefined) { clearTimeout(timer); timer = undefined }
+    save()
+  })
+}
