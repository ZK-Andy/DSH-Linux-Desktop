+  return {
+    ...actual,
+    spawn: vi.fn((program: string, args: string[], options?: unknown) => {
+      spawned.calls.push([program, ...args])
+      spawned.options.push(options)
+      const stdout = new EventEmitter()
+      const stderr = new EventEmitter()
+      const listeners = new Map<string, ((code: number | null) => void)[]>()
+      const kill = vi.fn()
+      spawned.child = {
+        stdout: stdout as unknown as Emitter,
+        stderr: stderr as unknown as Emitter,
+        kill,
+        on: (event, cb) => { listeners.set(event, [...listeners.get(event) ?? [], cb]) },
+      }
+      Object.assign(spawned.child, {
+        emitClose: (code: number | null) => { for (const cb of listeners.get('close') ?? []) cb(code) },
+      })
+      return spawned.child
+    }),
+  }
+})
