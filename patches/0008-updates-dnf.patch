+++ b/apps/desktop/src/update-download.ts
@@ -0,0 +1,101 @@
+/**
+ * Linux update download: fetch the signed rpm named by the release manifest, hash it while it
+ * streams, and verify the OpenPGP signature before the helper is ever allowed to install it.
+ *
+ * Bytes that fail either check are deleted; a partial file never reaches a user-visible path.
+ */
+import { createHash } from 'node:crypto'
+import { createReadStream, createWriteStream, existsSync } from 'node:fs'
+import { mkdir, rename, rm, stat } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Readable } from 'node:stream'
+import { pipeline } from 'node:stream/promises'
+import { execFile } from 'node:child_process'
+import { mkdtemp } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { promisify } from 'node:util'
+import type { DesktopReleaseFeed } from './update-feed.ts'
+
+const run = promisify(execFile)
+
+/** @param feed - Validated manifest. @returns Asset download URL for the release tag. */
+export function releaseAssetUrl(feed: DesktopReleaseFeed): string {
+  return `https://github.com/ZK-Andy/DSH-Linux-Desktop/releases/download/${feed.tag}/${feed.package}`
+}
+
+/** @param feed - Validated manifest. @returns File name inside the user's cache directory. */
+export function releaseAssetName(feed: DesktopReleaseFeed): string {
+  return feed.package
+}
+
+async function sha256File(path: string): Promise<string> {
+  const hash = createHash('sha256')
+  await pipeline(createReadStream(path), hash)
+  return hash.digest('hex')
+}
+
+/**
+ * @param directory - Download directory; created when missing.
+ * @param feed - Validated manifest.
+ * @param onProgress - Percent callback, 0-100.
+ * @returns Path of a fully downloaded and hash-verified rpm.
+ */
+export async function downloadRelease(
+  directory: string,
+  feed: DesktopReleaseFeed,
+  onProgress: (percent: number) => void,
+): Promise<string> {
+  await mkdir(directory, { recursive: true })
+  const target = join(directory, releaseAssetName(feed))
+  if (existsSync(target) && (await stat(target)).size === feed.bytes && await sha256File(target) === feed.sha256) return target
+
+  const partial = `${target}.part`
+  await rm(partial, { force: true })
+  const response = await fetch(releaseAssetUrl(feed), { redirect: 'follow' })
+  if (!response.ok || response.body === null) throw new Error(`更新包下载失败：HTTP ${response.status}`)
+  const declared = Number(response.headers.get('content-length') ?? '0')
+  if (declared > 0 && declared !== feed.bytes) throw new Error(`更新包长度不符：清单 ${feed.bytes}，服务器 ${declared}`)
+
+  const hash = createHash('sha256')
+  let received = 0
+  const body = Readable.fromWeb(response.body as Parameters<typeof Readable.fromWeb>[0])
+  body.on('data', (chunk: Buffer) => {
+    received += chunk.length
+    hash.update(chunk)
+    // Report at most one percent step at a time; the sink is fire-and-forget by contract.
+    onProgress(Math.min(99, Math.floor((received / feed.bytes) * 100)))
+  })
+  await pipeline(body, createWriteStream(partial, { mode: 0o644 }))
+  if (received !== feed.bytes) {
+    await rm(partial, { force: true })
+    throw new Error(`更新包不完整：收到 ${received} 字节，清单要求 ${feed.bytes}`)
+  }
+  const digest = hash.digest('hex')
+  if (digest !== feed.sha256) {
+    await rm(partial, { force: true })
+    throw new Error(`更新包 sha256 不符：收到 ${digest}`)
+  }
+  await rename(partial, target)
+  onProgress(100)
+  return target
+}
+
+/**
+ * @param rpmPath - Downloaded package.
+ * @param keyPath - Public key shipped with the application.
+ * @returns true when rpm reports a valid OpenPGP signature over the header and payload.
+ */
+export async function verifySignedPackage(rpmPath: string, keyPath: string): Promise<boolean> {
+  const db = await mkdtemp(join(tmpdir(), 'dsh-update-keys-'))
+  try {
+    await run('rpm', ['--dbpath', db, '--import', keyPath], { encoding: 'utf8' })
+    // Non-verbose on purpose: `-Kv` prints one line per digest and never emits
+    // "digests signatures OK", which made every signed package look unverified.
+    const { stdout } = await run('rpm', ['--dbpath', db, '-K', rpmPath], { encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' } })
+    return /digests signatures OK/.test(stdout)
+  } catch {
+    return false
+  } finally {
+    await rm(db, { recursive: true, force: true })
+  }
+}
diff --git a/apps/desktop/src/update-feed.ts b/apps/desktop/src/update-feed.ts
new file mode 100644
index 00000000..340c4a13
--- /dev/null
+++ b/apps/desktop/src/update-feed.ts
@@ -0,0 +1,89 @@
+/**
+ * Linux update feed: the release asset `version.json` published next to the signed rpm.
+ *
+ * The electron-updater feed is replaced on Linux because the installer is the package manager:
+ * a release is one signed rpm and one JSON manifest describing it. Everything here is pure so the
+ * parser and the comparison can be unit-tested without Electron or the network.
+ */
+
+/** Where a packaged Linux build looks for the newest release manifest. */
+export const LINUX_UPDATE_FEED_URL = 'https://github.com/ZK-Andy/DSH-Linux-Desktop/releases/latest/download/version.json'
+
+/** One published release, validated field by field before any download is allowed. */
+export interface DesktopReleaseFeed {
+  /** semver-comparable form used by the update coordinator (0.2.2-alpha.2.2). */
+  readonly version: string
+  /** Published tag (v0.2.2-alpha.2-2). */
+  readonly tag: string
+  readonly rpmVersion: string
+  readonly rpmRelease: string
+  readonly package: string
+  readonly sha256: string
+  readonly bytes: number
+  readonly publishedAt?: string
+  readonly signingKeyId?: string
+}
+
+const PACKAGE_NAME = /^dsh-desktop-[0-9A-Za-z.~+_-]+\.rpm$/
+const SHA256 = /^[0-9a-f]{64}$/
+const SEMVER = /^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/
+
+class FeedFieldError extends Error {
+  readonly field: string
+
+  constructor(field: string, detail: string) {
+    super(`更新清单的 ${field} 不可信：${detail}`)
+    this.field = field
+  }
+}
+
+const text = (value: unknown, field: string, pattern?: RegExp): string => {
+  if (typeof value !== 'string' || value.length === 0) throw new FeedFieldError(field, '不是非空字符串')
+  if (pattern !== undefined && !pattern.test(value)) throw new FeedFieldError(field, `格式不匹配：${value}`)
+  return value
+}
+
+/**
+ * @param value - Parsed JSON from the release asset.
+ * @returns The manifest with every field narrowed.
+ * @throws FeedFieldError when a field is missing or malformed; the caller reports it instead of downloading.
+ */
+export function parseReleaseFeed(value: unknown): DesktopReleaseFeed {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new FeedFieldError('根', '不是对象')
+  const record = value as Record<string, unknown>
+  const bytes = record.bytes
+  if (typeof bytes !== 'number' || !Number.isInteger(bytes) || bytes <= 0) throw new FeedFieldError('bytes', '不是正整数')
+  const publishedAt = record.publishedAt
+  const signingKeyId = record.signingKeyId
+  const version = text(record.version, 'version', SEMVER)
+  // The release must ride in a numeric segment (…alpha.2.2); a tag-style …alpha.2-2 would compare
+  // wrong the moment the release reaches two digits.
+  if (!/\.\d+$/.test(version)) throw new FeedFieldError('version', `缺少数值打包号：${version}`)
+  return {
+    version,
+    tag: text(record.tag, 'tag', /^v\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?-\d+$/),
+    rpmVersion: text(record.rpmVersion, 'rpmVersion'),
+    rpmRelease: text(record.rpmRelease, 'rpmRelease', /^\d+$/),
+    package: text(record.package, 'package', PACKAGE_NAME),
+    sha256: text(record.sha256, 'sha256', SHA256),
+    bytes,
+    ...(typeof publishedAt === 'string' && publishedAt.length > 0 ? { publishedAt } : {}),
+    ...(typeof signingKeyId === 'string' && signingKeyId.length > 0 ? { signingKeyId } : {}),
+  }
+}
+
+/**
+ * @param url - Manifest URL.
+ * @param timeoutMs - Abort budget for the whole request.
+ * @returns The validated manifest.
+ * @throws Error with the HTTP status or parse failure; callers surface it as a check failure.
+ */
+export async function fetchReleaseFeed(url: string, timeoutMs: number): Promise<DesktopReleaseFeed> {
+  const response = await fetch(url, {
+    redirect: 'follow',
+    headers: { accept: 'application/json' },
+    signal: AbortSignal.timeout(timeoutMs),
+  })
+  if (!response.ok) throw new Error(`更新清单请求失败：HTTP ${response.status}`)
+  return parseReleaseFeed(await response.json())
+}
diff --git a/apps/desktop/src/update-linux.ts b/apps/desktop/src/update-linux.ts
new file mode 100644
index 00000000..271f31d5
--- /dev/null
+++ b/apps/desktop/src/update-linux.ts
@@ -0,0 +1,159 @@
+/**
+ * Linux package updater: the electron-updater surface the coordinator needs, backed by the
+ * release manifest and the system package manager instead of an embedded installer.
+ *
+ * Only three methods are consumed by DesktopUpdateCoordinator: checkForUpdates, downloadUpdate and
+ * quitAndInstall. Installation never happens in this process: a polkit-authorized helper runs
+ * `dnf5 install` on the verified rpm, and the application relaunches after the helper succeeds.
+ */
+import { EventEmitter } from 'node:events'
+import { execFile, execFileSync } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+import { app } from 'electron'
+import { fetchReleaseFeed, type DesktopReleaseFeed } from './update-feed.ts'
+import { downloadRelease, verifySignedPackage } from './update-download.ts'
+
+const run = promisify(execFile)
+
+/** Shape returned by checkForUpdates; mirrors the fields the coordinator reads. */
+interface LinuxCheckResult {
+  readonly updateInfo: { readonly version: string }
+  readonly isUpdateAvailable: boolean
+}
+
+export interface LinuxUpdaterOptions {
+  /** Published manifest URL. */
+  readonly feedUrl: string
+  /** Cache directory for downloaded packages. */
+  readonly cacheDir: string
+  /** Public key shipped next to the application; undefined outside a packaged app. */
+  readonly keyPath?: string
+  /** Installed polkit helper; its absence disables the update stack. */
+  readonly helperPath?: string
+  /** Request budget for the manifest and the package. */
+  readonly timeoutMs?: number
+  /** Relaunch after a successful install; overridable for tests. */
+  readonly relaunch?: () => void
+}
+
+/**
+ * @returns The Release segment of the installed rpm, or undefined when the rpm database cannot be queried.
+ */
+export async function installedRpmRelease(): Promise<string | undefined> {
+  try {
+    const { stdout } = await run('rpm', ['-q', '--qf', '%{RELEASE}', 'dsh-desktop'], { encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' } })
+    const value = stdout.trim()
+    return /^\d+$/.test(value) ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** Sync variant for the coordinator's `currentVersion` provider; the rpm query is a single local read. */
+export function installedRpmReleaseSync(): string | undefined {
+  try {
+    const value = execFileSync('rpm', ['-q', '--qf', '%{RELEASE}', 'dsh-desktop'], {
+      encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' },
+    }).trim()
+    return /^\d+$/.test(value) ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** electron's getPath has no 'cache' key in this typings version; XDG wins, then ~/.cache. */
+export function defaultCacheDir(): string {
+  const xdg = process.env.XDG_CACHE_HOME
+  return join(xdg !== undefined && xdg.length > 0 ? xdg : join(homedir(), '.cache'), 'dsh-desktop')
+}
+
+export class LinuxPackageUpdater extends EventEmitter {
+  autoDownload = false
+  autoInstallOnAppQuit = false
+  channel = 'nightly'
+  allowPrerelease = true
+  allowDowngrade = false
+
+  private feed: DesktopReleaseFeed | undefined
+  private packagePath: string | undefined
+
+  private readonly options: LinuxUpdaterOptions
+
+  constructor(options: LinuxUpdaterOptions) {
+    super()
+    this.options = options
+  }
+
+  /** @returns Whether the helper this stack depends on is installed. */
+  available(): boolean {
+    const helper = this.options.helperPath
+    return helper !== undefined && existsSync(helper)
+  }
+
+  /**
+   * @returns The published release; the coordinator decides whether it is newer than this build.
+   * @throws When the manifest cannot be fetched or validated.
+   */
+  async checkForUpdates(): Promise<LinuxCheckResult> {
+    const feed = await fetchReleaseFeed(this.options.feedUrl, this.options.timeoutMs ?? 20_000)
+    this.feed = feed
+    return { updateInfo: { version: feed.version }, isUpdateAvailable: true }
+  }
+
+  /**
+   * Downloads and verifies the checked release.
+   * @throws When no check ran, the hash does not match, or the signature is invalid.
+   */
+  async downloadUpdate(): Promise<void> {
+    const feed = this.feed
+    if (feed === undefined) throw new Error('desktop update: 没有已检查的更新')
+    const path = await downloadRelease(this.options.cacheDir, feed, (percent) => {
+      this.emit('download-progress', { percent, transferred: 0, total: feed.bytes, bytesPerSecond: 0 })
+    })
+    const keyPath = this.options.keyPath
+    if (keyPath === undefined) throw new Error('desktop update: 没有随包签名公钥')
+    if (!await verifySignedPackage(path, keyPath)) {
+      throw new Error('desktop update: 更新包签名校验未通过')
+    }
+    this.packagePath = path
+    this.emit('update-downloaded', { version: feed.version })
+  }
+
+  /**
+   * Hands the verified package to the polkit helper, then relaunches on success.
+   * Errors after this point are emitted rather than thrown; the caller has already returned.
+   */
+  quitAndInstall(): void {
+    const path = this.packagePath
+    if (path === undefined) {
+      this.emit('error', new Error('desktop update: 没有已下载的更新包'))
+      return
+    }
+    const helper = this.options.helperPath
+    if (helper === undefined) {
+      this.emit('error', new Error('desktop update: 没有 polkit helper'))
+      return
+    }
+    const child = execFile('pkexec', [helper, path], (error) => {
+      if (error !== null) {
+        this.emit('error', new Error(`desktop update: 安装失败：${error.message}`))
+        return
+      }
+      this.emit('installed', { version: this.feed?.version, path })
+      if (this.options.relaunch !== undefined) this.options.relaunch()
+      else {
+        app.relaunch()
+        app.exit(0)
+      }
+    })
+    child.on('error', (error) => { this.emit('error', error) })
+  }
+
+  /** @returns Cache path used by this instance; exposed for the CI upgrade case. */
+  static cacheDirectory(): string {
+    return defaultCacheDir()
+  }
+}
