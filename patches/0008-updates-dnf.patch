@@ -0,0 +1,35 @@
+import { app } from 'electron'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { LINUX_UPDATE_FEED_URL } from './update-feed.ts'
+import { LinuxPackageUpdater, defaultCacheDir, installedRpmReleaseSync } from './update-linux.ts'
+
+export interface LinuxUpdateRuntime {
+  updater?: LinuxPackageUpdater
+  enabled?: () => boolean
+  currentVersion?: () => string
+}
+
+/**
+ * Linux installs through the package manager, so the coordinator talks to a release-manifest
+ * updater whose install step is a polkit-authorized helper; the embedded updater is never used.
+ * The installed rpm release is part of the compared version, otherwise every start would offer
+ * the build that is already installed.
+ * @returns updater plus the coordinator hooks; empty off Linux.
+ */
+export function linuxUpdateRuntime(): LinuxUpdateRuntime {
+  if (process.platform !== 'linux') return {}
+  const updater = new LinuxPackageUpdater({
+    feedUrl: LINUX_UPDATE_FEED_URL,
+    cacheDir: defaultCacheDir(),
+    // Tests and development runs have no resourcesPath; an update is then simply unavailable.
+    ...process.resourcesPath === undefined ? {} : { keyPath: join(process.resourcesPath, 'RPM-GPG-KEY-dsh-desktop') },
+    ...existsSync('/usr/libexec/dsh-update-helper') ? { helperPath: '/usr/libexec/dsh-update-helper' } : {},
+  })
+  const release = installedRpmReleaseSync()
+  return {
+    updater,
+    enabled: () => updater.available(),
+    ...release === undefined ? {} : { currentVersion: () => `${app.getVersion()}.${release}` },
+  }
+}
