+type Emitter = { on: (event: string, cb: (code: number | null) => void) => void }
+
+const spawned = await vi.hoisted(async () => {
+  return {
+    calls: [] as string[][],
+    options: [] as unknown[],
+    child: undefined as undefined | {
+      stdout: Emitter
+      stderr: Emitter
