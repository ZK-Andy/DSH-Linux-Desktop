--- /dev/null
+++ b/apps/desktop/src/linux-updates.ts
@@ -0,0 +1,32 @@
+import { existsSync } from 'node:fs'
+import {
+  LINUX_UPDATER_HELPER, LinuxPackageUpdater, currentLinuxVersion,
+} from './update-linux.ts'
+
+export interface LinuxUpdateRuntime {
+  updater?: LinuxPackageUpdater
+  enabled?: () => boolean
+  currentVersion?: () => string
+}
+
+/**
+ * Linux updates go through the shipped dnf repository: the updater only asks dnf whether an
+ * upgrade exists, and the polkit helper installs it. The installed rpm release is part of the
+ * compared version, otherwise every start would offer the build that is already installed.
+ * @param options.relaunch - Stops the application before the upgraded build starts again.
+ * @returns updater plus the coordinator hooks; empty off Linux.
+ */
+export function linuxUpdateRuntime(options: { readonly relaunch?: () => void } = {}): LinuxUpdateRuntime {
+  if (process.platform !== 'linux') return {}
+  const helperPath = existsSync(LINUX_UPDATER_HELPER) ? LINUX_UPDATER_HELPER : undefined
+  const updater = new LinuxPackageUpdater({
+    ...helperPath === undefined ? {} : { helperPath },
+    currentVersion: currentLinuxVersion,
+    ...options.relaunch === undefined ? {} : { relaunch: options.relaunch },
+  })
+  return {
+    updater,
+    enabled: () => updater.available(),
+    currentVersion: currentLinuxVersion,
+  }
+}
diff --git a/apps/desktop/src/update-linux.ts b/apps/desktop/src/update-linux.ts
new file mode 100644
index 00000000..4c93591f
--- /dev/null
+++ b/apps/desktop/src/update-linux.ts
@@ -0,0 +1,418 @@
+/**
+ * Linux updater: the electron-updater surface the coordinator consumes, backed entirely by the
+ * system package manager. No manifest is fetched and no rpm is downloaded or verified here —
+ * `dnf5` discovers the update through the shipped repository and installs it through the polkit
+ * helper. The only things this file owns are version encoding, the two dnf queries, and the
+ * channel's repository section: the coordinator sets `channel` (electron-updater's own field) and
+ * every check and install reads it at call time, so a channel switch needs no further wiring.
+ * The repository file is the one exception: an rpm upgrade leaves a locally edited
+ * `%config(noreplace)` copy in place, and such a file may predate the channel sections, so the
+ * check degrades to the single repository that file declares instead of asking dnf for a feed
+ * whose section does not exist (dnf5 exits 2 on an unmatched repository id).
+ */
+import { EventEmitter } from 'node:events'
+import { execFileSync, spawn } from 'node:child_process'
+import { appendFileSync, chmodSync, existsSync, mkdirSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { app } from 'electron'
+import type { DesktopUpdateChannel } from './update-channel.ts'
+
+
+/** Package name in the rpm database; also the repository's only package. */
+export const LINUX_PACKAGE_NAME = 'dsh-desktop'
+
+/** Root entry point installed by the rpm; it takes the selected channel as its only argument. */
+export const LINUX_UPDATER_HELPER = '/usr/libexec/dsh-update-helper'
+
+/**
+ * Repository section per channel, both defined in packaging/dsh-desktop.repo. The section name is
+ * the only place a channel turns into a dnf repository, so check and install cannot drift apart.
+ */
+const CHANNEL_REPO: Readonly<Record<DesktopUpdateChannel, string>> = {
+  nightly: 'dsh-desktop-nightly',
+  stable: 'dsh-desktop',
+}
+
+/** The other channel, so a check disables exactly the feed it is not asking. */
+function otherChannel(channel: DesktopUpdateChannel): DesktopUpdateChannel {
+  return channel === 'nightly' ? 'stable' : 'nightly'
+}
+
+/** Repository definition shipped by the rpm; the only place the channel sections are declared. */
+export const LINUX_REPO_FILE = '/etc/yum.repos.d/dsh-desktop.repo'
+
+/**
+ * @param repoFile - Repository definition to inspect; defaults to the shipped path.
+ * @returns Whether both channel sections are declared. An rpm-installed file declares them; a
+ *   `%config(noreplace)` file kept from a locally edited mirror or proxy usually does not, and
+ *   dnf5 rejects `--enablerepo` for an id it cannot match (exit 2), so the caller must fall back
+ *   to a single-repository query instead of failing every check.
+ */
+export function hasChannelSections(repoFile: string = LINUX_REPO_FILE): boolean {
+  try {
+    const text = readFileSync(repoFile, 'utf8')
+    return /^\[dsh-desktop\]/m.test(text) && /^\[dsh-desktop-nightly\]/m.test(text)
+  } catch {
+    return false
+  }
+}
+
+/** How many helper output lines survive for the failure dialog. */
+export const INSTALL_LOG_LINES = 10
+
+/** Wall-clock budget for one dnf query: dnf can block on prompts, locks, or a stalled mirror. */
+export const QUERY_TIMEOUT_MS = 120_000
+
+/** Wall-clock budget for the polkit helper: a dnf upgrade can take minutes, but not forever. */
+export const INSTALL_TIMEOUT_MS = 10 * 60_000
+
+/** Wall-clock budget for the synchronous rpm -q probe; its ETIMEDOUT falls back to app.getVersion(). */
+export const VERSION_PROBE_TIMEOUT_MS = 2_000
+
+/**
+ * pkexec exits 127 when the authorization cannot be obtained or an error occurs; a dialog the user
+ * dismissed is 126. So 127 means the helper never ran and pkexec's stderr is the only witness.
+ */
+export const PKEXEC_NOT_AUTHORIZED = 127
+
+/** Appended file under the application logs directory; one record per failed install. */
+const FAILURE_LOG_NAME = 'update-failures.log'
+
+/**
+ * The only variable pkexec itself receives. pkexec resets the helper's environment to a minimal
+ * known-safe set (man pkexec SECURITY NOTES), so the helper never inherits ours — what does
+ * reach pkexec's own process is this list, and GDBus reads DBUS_SYSTEM_BUS_ADDRESS from it to
+ * find the authorization authority. The 2026-11-05 incident was a poisoned instance environment
+ * doing exactly that: authorization broke before it started, and the tray relaunch kept the
+ * poison alive across instances. Nothing else is passed on purpose: pkexec execs the absolute
+ * helper path without PATH lookup, and the system bus is reached through the default socket.
+ * Verified on a real machine: with `env -i LC_ALL=C` the whole chain (pkexec → authorization →
+ * helper → dnf5) succeeds. LC_ALL is not required either — it only keeps pkexec's own messages
+ * stable; the helper never sees it, since pkexec rebuilds the program's environment.
+ * Do not widen this for the helper's sake — the helper needs nothing from us.
+ */
+const helperEnv = (): Record<string, string> => ({ LC_ALL: 'C' })
+
+/** Strips ANSI control sequences and the carriage-return progress tail dnf redraws in place. */
+export function stripProgress(line: string): string {
+  return line
+    .replace(/\u001b\[[0-9;?]*[A-Za-z]/gu, '')
+    .replace(/\r/g, '')
+    .trim()
+}
+
+/** Shape returned by checkForUpdates; mirrors the fields the coordinator reads. */
+interface LinuxCheckResult {
+  readonly updateInfo: { readonly version: string }
+  readonly isUpdateAvailable: boolean
+}
+
+export interface LinuxUpdaterOptions {
+  /** Installed polkit helper; its absence disables the update stack. */
+  readonly helperPath?: string
+  /** Version compared by the coordinator; defaults to the packaged application version. */
+  readonly currentVersion?: () => string
+  /** Relaunch after a successful install; overridable for tests. */
+  readonly relaunch?: () => void
+  /** dnf runner; overridable for tests. Receives whether the query must bypass the cache. */
+  readonly queryUpgrades?: (refresh: boolean) => Promise<string>
+  /** Receives one record per failed install; defaults to appending under the application logs. */
+  readonly failureSink?: (record: string) => void
+  /** Repository definition to consult; overridable for tests, defaults to the shipped path. */
+  readonly repoFile?: string
+}
+
+/**
+ * Encode an rpm EVR as a semver that electron-updater's `gt()` orders the way rpm orders releases.
+ * Prerelease builds keep their prerelease segment (`0.2.2~alpha.2-6` → `0.2.2-alpha.2.6`); stable
+ * builds get a `.z` marker so they sort after every prerelease of the same version
+ * (`0.2.3-1` → `0.2.3.z.1`). Epoch prefixes are stripped because rpm prints them as `0:`.
+ * @param version - `%{VERSION}` or `%{EVR}`; a trailing `-<release>` is split off when present.
+ * @param release - `%{RELEASE}` to append when `version` has none.
+ * @returns Semver-shaped version for the coordinator's comparison.
+ */
+export function encodeVersion(evr: string, fallbackRelease = ''): string {
+  const withoutEpoch = evr.replace(/^\d+:/, '')
+  const cut = withoutEpoch.lastIndexOf('-')
+  const tail = cut === -1 ? '' : withoutEpoch.slice(cut + 1)
+  const hasRelease = cut !== -1 && /^\d+$/.test(tail)
+  const base = hasRelease ? withoutEpoch.slice(0, cut) : withoutEpoch
+  const segment = hasRelease ? tail : fallbackRelease
+  if (segment.length === 0) return base
+  return base.includes('~') ? `${base.replace('~', '-')}.${segment}` : `${base}-z.${segment}`
+}
+
+/** @returns The first EVR reported for the package, or undefined when dnf reports no upgrade. */
+export function parseUpgrade(evrOutput: string): string | undefined {
+  return evrOutput.split('\n').map(line => line.trim()).find(line => line.length > 0)
+}
+
+/** @returns The Release segment of the installed rpm, or undefined when the rpm database cannot be queried. */
+export function installedRpmReleaseSync(): string | undefined {
+  try {
+    const value = execFileSync('rpm', ['-q', '--qf', '%{RELEASE}', LINUX_PACKAGE_NAME], {
+      encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' },
+      // Bounded like installedEvrSync: rpm -q can wait on a transaction lock after an upgrade.
+      timeout: VERSION_PROBE_TIMEOUT_MS,
+    }).trim()
+    return /^\d+$/.test(value) ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** @returns The installed rpm EVR (`version-release`), or undefined outside an rpm install. */
+export function installedEvrSync(): string | undefined {
+  try {
+    const value = execFileSync('rpm', ['-q', '--qf', '%{VERSION}-%{RELEASE}', LINUX_PACKAGE_NAME], {
+      encoding: 'utf8', env: { ...process.env, LC_ALL: 'C' },
+      // Bounded: rpm -q can wait on a transaction lock right after a failed upgrade, and this
+      // probe also feeds the failure record — it must never stall the error being reported.
+      timeout: VERSION_PROBE_TIMEOUT_MS,
+    }).trim()
+    return /^\S+-\d+$/.test(value) ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * @param evr The installed rpm EVR to encode; `null` forces the packaged-version fallback, and
+ *   leaving it undefined probes the rpm database (the caller usually wants the injection in tests).
+ * @returns The installed version+release encoded the same way dnf results are.
+ */
+export function currentLinuxVersion(evr: string | null | undefined = installedEvrSync()): string {
+  return evr === null || evr === undefined ? app.getVersion() : encodeVersion(evr)
+}
+
+export class LinuxPackageUpdater extends EventEmitter {
+  autoDownload = false
+  autoInstallOnAppQuit = false
+  channel: DesktopUpdateChannel = 'nightly'
+  allowPrerelease = true
+  allowDowngrade = false
+
+  private candidate: string | undefined
+
+  private manual = false
+
+  private legacyRepoWarned = false
+
+  private readonly options: LinuxUpdaterOptions
+
+  constructor(options: LinuxUpdaterOptions = {}) {
+    super()
+    this.options = options
+  }
+
+  /**
+   * Marks the next check as user-triggered. Manual checks ask dnf with `--refresh`, because the
+   * repository caches metadata for an hour and a version published minutes ago must still show up.
+   */
+  markManualCheck(): void {
+    this.manual = true
+  }
+
+  /** @returns Whether the helper this stack depends on is installed. */
+  available(): boolean {
+    const helper = this.options.helperPath
+    return helper !== undefined && existsSync(helper)
+  }
+
+  /**
+   * Asks the package manager whether an upgrade exists in the selected channel.
+   * @returns The upgrade candidate, or the current version when there is none.
+   * @throws When dnf cannot be queried; the coordinator surfaces the message as-is.
+   */
+  async checkForUpdates(): Promise<LinuxCheckResult> {
+    const refresh = this.manual
+    this.manual = false
+    const evr = parseUpgrade(await this.queryUpgrades(refresh))
+    if (evr === undefined) {
+      this.candidate = undefined
+      return { updateInfo: { version: this.current() }, isUpdateAvailable: false }
+    }
+    const version = encodeVersion(evr, '')
+    this.candidate = version
+    return { updateInfo: { version }, isUpdateAvailable: true }
+  }
+
+  /**
+   * Nothing is downloaded into a private cache: dnf fetches what it needs during the upgrade.
+   * The step exists because the coordinator asks for an explicit preparation before install.
+   * @throws When no check ran or the helper is missing.
+   */
+  async downloadUpdate(): Promise<void> {
+    const version = this.candidate
+    if (version === undefined) throw new Error('desktop update: 没有已检查的更新')
+    if (!this.available()) throw new Error('desktop update: 没有 polkit helper')
+    this.emit('update-downloaded', { version })
+  }
+
+  /**
+   * Hands control to the polkit helper, which runs `dnf5 upgrade dsh-desktop`, then relaunches.
+   * Errors after this point are emitted rather than thrown; the caller has already returned.
+   */
+  quitAndInstall(): void {
+    const helper = this.options.helperPath
+    if (helper === undefined || !existsSync(helper)) {
+      this.fail(new Error('desktop update: 没有 polkit helper'), [], null)
+      return
+    }
+    const lines: string[] = []
+    let latest = ''
+    const consume = (chunk: Buffer): void => {
+      for (const raw of chunk.toString('utf8').split('\n')) {
+        const line = stripProgress(raw)
+        if (line.length === 0) continue
+        latest = line
+        lines.push(line)
+        if (lines.length > INSTALL_LOG_LINES) lines.shift()
+        this.emit('install-progress', { line: latest })
+      }
+    }
+    let settled = false
+    const child = spawn('pkexec', [helper, `--channel=${this.channel}`], {
+      env: helperEnv(),
+      // polkit prompts through the desktop agent, not stdin; the helper inherits this pipe, and
+      // a pipe nobody writes to or closes can block a prompt exactly like it blocks dnf5.
+      stdio: ['ignore', 'pipe', 'pipe'],
+    })
+    const timer = setTimeout(() => {
+      // SIGKILL reaps the helper only: pkexec keeps the pid, but the dnf5 transaction the helper
+      // started may outlive it, so this budget bounds the wait in the UI, not the upgrade itself.
+      // When that orphan finishes, the next check sees the new rpm release and clears the update.
+      child.kill('SIGKILL')
+      failOnce(new Error(`dnf5 upgrade 超过 ${INSTALL_TIMEOUT_MS / 1000} 秒未返回，已终止`), null)
+    }, INSTALL_TIMEOUT_MS)
+    const failOnce = (error: Error, code: number | null): void => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      this.fail(error, lines, code)
+    }
+    child.stdout.on('data', consume)
+    child.stderr.on('data', consume)
+    child.on('error', (error) => { failOnce(error, null) })
+    child.on('close', (code) => {
+      if (settled) return
+      if (code === 0) {
+        settled = true
+        clearTimeout(timer)
+        this.emit('installed', { version: this.candidate })
+        if (this.options.relaunch !== undefined) this.options.relaunch()
+        else {
+          app.relaunch()
+          app.exit(0)
+        }
+        return
+      }
+      // 127 is pkexec itself, not the helper: the helper never ran. It covers both a failed
+      // authorization and a failed exec of the helper (EACCES, noexec mount, SELinux), so the
+      // wording names both. A poisoned process environment can break pkexec for one app instance
+      // only (2026-11-05 real machine), and the tray restart goes through app.relaunch(), which
+      // inherits that environment — so the guidance is a full quit followed by a fresh launch.
+      const message = code === PKEXEC_NOT_AUTHORIZED
+        ? 'desktop update: 安装失败：helper 退出码 127（认证通道异常或 helper 无法执行，彻底退出应用后重新打开再试）'
+        : `desktop update: 安装失败：helper 退出码 ${code ?? 'unknown'}`
+      failOnce(new Error(message), code)
+    })
+  }
+
+  private fail(error: Error, lines: readonly string[], code: number | null): void {
+    const details = [code === null ? '' : `退出码：${code}`, ...lines].filter(l => l.length > 0).join('\n')
+    const failure = Object.assign(error, { technicalDetails: details })
+    this.recordFailure(error, details)
+    this.emit('error', failure)
+  }
+
+  /**
+   * Persists what the install actually reported. pkexec logs only its successes to the system
+   * journal — a failed authorization leaves nothing — and the failure toast dies with the session,
+   * so a recurring failure would leave no witness on disk. Each record carries the versions that
+   * frame the attempt; every entry is bounded (two version lines plus the last helper lines), so
+   * the file grows by a few lines per failure and needs no rotation. Best effort: a failed write
+   * must not shadow the install error being reported, which is why the injected sink shares the
+   * try with the file write.
+   */
+  private recordFailure(error: Error, details: string): void {
+    try {
+      // Building the record stays inside the try: this.current() reaches into app or a caller's
+      // provider, and nothing on this path may shadow the install error being reported.
+      const context = `候选版本 ${this.candidate ?? '无'}，当前版本 ${this.current()}`
+      const record = `${new Date().toISOString()} ${error.message}\n${context}${details.length > 0 ? `\n${details}` : ''}\n\n`
+      if (this.options.failureSink !== undefined) {
+        this.options.failureSink(record)
+        return
+      }
+      const directory = app.getPath('logs')
+      mkdirSync(directory, { recursive: true, mode: 0o700 })
+      appendFileSync(join(directory, FAILURE_LOG_NAME), record, { mode: 0o600 })
+      // Hardening runs after the record is on disk: mkdirSync's mode only applies to directories
+      // it creates (the logs directory usually exists, shared with crash reports), and a failing
+      // chmod (foreign owner, read-only mount) must not cost us the witness.
+      chmodSync(directory, 0o700)
+    } catch {
+      // Keep the install error as the only reported failure.
+    }
+  }
+
+  private current(): string {
+    const provider = this.options.currentVersion
+    return provider === undefined ? app.getVersion() : provider()
+  }
+
+  /** Says once per instance that the installed repository file cannot express a channel. */
+  private warnLegacyRepo(): void {
+    if (this.legacyRepoWarned) return
+    this.legacyRepoWarned = true
+    console.warn(`[dsh-desktop] ${this.options.repoFile ?? LINUX_REPO_FILE} 没有渠道 section`
+      + '（旧版或本地改过的 .repo）；本次按单仓库检查，渠道选择可能不生效；装上随包的新 .repo 后自动恢复')
+  }
+
+  private queryUpgrades(refresh: boolean): Promise<string> {
+    if (this.options.queryUpgrades !== undefined) return this.options.queryUpgrades(refresh)
+    return new Promise((resolve, reject) => {
+      // Both repository sections ship together, so the pair names both feeds even though only one
+      // is enabled: dnf5 rejects an id it cannot match, and an unknown feed must fail loudly. An
+      // old `%config(noreplace)` file may declare only `[dsh-desktop]`; the pair would then abort
+      // every check, so degrade to that single repository and say the channel cannot be expressed.
+      const selected = CHANNEL_REPO[this.channel]
+      const channelSections = hasChannelSections(this.options.repoFile)
+      if (!channelSections) this.warnLegacyRepo()
+      const repoArgs = channelSections
+        ? [`--disablerepo=${CHANNEL_REPO[otherChannel(this.channel)]}`, `--enablerepo=${selected}`]
+        : []
+      const args = ['repoquery', '--upgrades', '--assumeyes', ...refresh ? ['--refresh'] : [], ...repoArgs,
+        '--queryformat', '%{evr}\n',
+        `--setopt=${channelSections ? selected : 'dsh-desktop'}.skip_if_unavailable=0`, LINUX_PACKAGE_NAME]
+      const child = spawn('dnf5', args, {
+        env: { ...process.env, LC_ALL: 'C' },
+        // dnf5 asks on stdin before importing repository OpenPGP keys, and a pipe nobody writes
+        // to would block that question forever; the prompt must see EOF instead.
+        stdio: ['ignore', 'pipe', 'pipe'],
+      })
+      let stdout = ''
+      let stderr = ''
+      let settled = false
+      const timer = setTimeout(() => {
+        child.kill('SIGKILL')
+        const tail = stderr.trim().split('\n').slice(-3).join('\n')
+        settle(new Error(`dnf5 repoquery 超过 ${QUERY_TIMEOUT_MS / 1000} 秒未返回，已终止${tail.length > 0 ? `\n${tail}` : ''}`))
+      }, QUERY_TIMEOUT_MS)
+      const settle = (error?: Error): void => {
+        if (settled) return
+        settled = true
+        clearTimeout(timer)
+        if (error === undefined) resolve(stdout)
+        else reject(error)
+      }
+      child.stdout.on('data', (chunk: Buffer) => { stdout += chunk.toString('utf8') })
+      child.stderr.on('data', (chunk: Buffer) => { stderr += chunk.toString('utf8') })
+      child.on('error', settle)
+      child.on('close', (code) => {
+        settle(code === 0 ? undefined : new Error(stderr.trim().length > 0 ? stderr.trim() : `dnf5 repoquery 退出码 ${code ?? 'unknown'}`))
+      })
+    })
+  }
+}
