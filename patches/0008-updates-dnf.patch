index 00000000..bb7e661d
--- /dev/null
+++ b/apps/desktop/tests/update-linux.spec.ts
@@ -0,0 +1,162 @@
+import { gt } from 'semver'
+import { describe, expect, it, vi } from 'vitest'
+import {
+  LinuxPackageUpdater, currentLinuxVersion, encodeVersion, parseUpgrade, stripProgress,
+} from '../src/update-linux.ts'
+
+vi.mock('electron', () => ({
+  app: { getVersion: () => '0.2.2-alpha.2', relaunch: vi.fn(), exit: vi.fn() },
+}))
+
+const spawned = await vi.hoisted(async () => {
+  type Emitter = { on: (event: string, cb: (code: number | null) => void) => void }
+  return { calls: [] as string[][], child: undefined as undefined | {
+    stdout: Emitter, stderr: Emitter, on: (event: string, cb: (code: number | null) => void) => void,
+  } }
+})
+vi.mock('node:child_process', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:child_process')>()
+  const { EventEmitter } = await import('node:events')
+  return {
+    ...actual,
+    spawn: vi.fn((program: string, args: string[]) => {
+      spawned.calls.push([program, ...args])
+      const stdout = new EventEmitter()
+      const stderr = new EventEmitter()
+      const listeners = new Map<string, ((code: number) => void)[]>()
+      spawned.child = {
+        stdout, stderr,
+        on: (event, cb) => { listeners.set(event, [...listeners.get(event) ?? [], cb]) },
+      }
+      Object.assign(spawned.child, {
+        emitClose: (code: number) => { for (const cb of listeners.get('close') ?? []) cb(code) },
+      })
+      return spawned.child
+    }),
+  }
+})
+
+function updater(overrides: Partial<ConstructorParameters<typeof LinuxPackageUpdater>[0]> = {}) {
+  return new LinuxPackageUpdater({
+    helperPath: '/bin/sh',
+    currentVersion: () => '0.2.2-alpha.2.5',
+    queryUpgrades: async () => '',
+    relaunch: vi.fn(),
+    ...overrides,
+  })
+}
+
+describe('encodeVersion', () => {
+  it('keeps the prerelease segment of an rpm EVR and appends the release', () => {
+    expect(encodeVersion('0.2.2~alpha.2-6', '')).toBe('0.2.2-alpha.2.6')
+    expect(encodeVersion('0:0.2.2~alpha.2-6', '')).toBe('0.2.2-alpha.2.6')
+    expect(encodeVersion('0.2.2~alpha.2', '6')).toBe('0.2.2-alpha.2.6')
+  })
+
+  it('marks stable builds so they sort after prereleases of the same version', () => {
+    expect(encodeVersion('0.2.3-1', '')).toBe('0.2.3-z.1')
+    expect(encodeVersion('0.2.3', '4')).toBe('0.2.3-z.4')
+  })
+
+  it('orders releases the way rpm orders them', () => {
+    expect(gt(encodeVersion('0.2.2~alpha.2-10', ''), encodeVersion('0.2.2~alpha.2-9', ''))).toBe(true)
+    expect(gt(encodeVersion('0.2.2~alpha.3-1', ''), encodeVersion('0.2.2~alpha.2-10', ''))).toBe(true)
+    expect(gt(encodeVersion('0.2.3-1', ''), encodeVersion('0.2.2~alpha.2-9', ''))).toBe(true)
+    expect(gt(encodeVersion('0.2.3~alpha.1-1', ''), encodeVersion('0.2.2-9', ''))).toBe(true)
+  })
+})
+
+describe('stripProgress', () => {
+  it('drops ANSI sequences and carriage-return redraws so only the readable line survives', () => {
+    expect(stripProgress('\u001b[1mdsh-desktop\u001b[0m  0.2.2~alpha.2-5')).toBe('dsh-desktop  0.2.2~alpha.2-5')
+    expect(stripProgress('下载中 12%\r下载中 48%\r下载中 96%')).toBe('下载中 12%下载中 48%下载中 96%')
+    expect(stripProgress('   ')).toBe('')
+  })
+})
+
+describe('parseUpgrade', () => {
+  it('returns the first reported EVR and ignores blank lines', () => {
+    expect(parseUpgrade('0.2.2~alpha.2-6\n\n')).toBe('0.2.2~alpha.2-6')
+    expect(parseUpgrade('')).toBeUndefined()
+    expect(parseUpgrade('\n \n')).toBeUndefined()
+  })
+})
+
+describe('LinuxPackageUpdater', () => {
+  it('reports the encoded candidate when dnf sees an upgrade', async () => {
+    const u = updater({ queryUpgrades: async () => '0.2.2~alpha.2-6\n' })
+    await expect(u.checkForUpdates()).resolves.toEqual({
+      updateInfo: { version: '0.2.2-alpha.2.6' }, isUpdateAvailable: true,
+    })
+  })
+
+  it('refreshes repository metadata only for a manual check', async () => {
+    const calls: boolean[] = []
+    const u = updater({ queryUpgrades: async (refresh) => { calls.push(refresh); return '' } })
+    await u.checkForUpdates()
+    u.markManualCheck()
+    await u.checkForUpdates()
+    expect(calls).toEqual([false, true])
+  })
+
+  it('reports the current version when dnf sees no upgrade', async () => {
+    const u = updater()
+    await expect(u.checkForUpdates()).resolves.toEqual({
+      updateInfo: { version: '0.2.2-alpha.2.5' }, isUpdateAvailable: false,
+    })
+  })
+
+  it('turns an empty check into a preparation failure instead of an install', async () => {
+    const u = updater()
+    await expect(u.downloadUpdate()).rejects.toThrow('没有已检查的更新')
+  })
+
+  it('prepares the install by reporting the candidate, not by downloading a package', async () => {
+    const u = updater({ queryUpgrades: async () => '0.2.2~alpha.2-6\n' })
+    await u.checkForUpdates()
+    const downloaded = vi.fn()
+    u.on('update-downloaded', downloaded)
+    await u.downloadUpdate()
+    expect(downloaded).toHaveBeenCalledWith({ version: '0.2.2-alpha.2.6' })
+  })
+
+  it('refuses to prepare when the helper is missing', async () => {
+    const u = updater({ helperPath: '/nonexistent/dsh-update-helper', queryUpgrades: async () => '0.2.2~alpha.2-6\n' })
+    await u.checkForUpdates()
+    await expect(u.downloadUpdate()).rejects.toThrow('没有 polkit helper')
+  })
+
+  it('streams helper lines and reports the exit code with the last ten lines', async () => {
+    const u = updater()
+    const errors: (Error & { technicalDetails?: string })[] = []
+    u.on('error', (error) => errors.push(error as Error & { technicalDetails?: string }))
+    const seen: string[] = []
+    u.on('install-progress', ({ line }) => { seen.push(line) })
+    u.quitAndInstall()
+    expect(spawned.calls[0]).toEqual(['pkexec', '/bin/sh'])
+    const child = spawned.child as unknown as {
+      stdout: { emit: (event: string, chunk: Buffer) => void }, stderr: { emit: (event: string, chunk: Buffer) => void },
+      emitClose: (code: number) => void,
+    }
+    child.stdout.emit('data', Buffer.from('第一条\n\u001b[1m第二条\u001b[0m\n'))
+    child.stderr.emit('data', Buffer.from('第三条\r\r\n'))
+    expect(seen).toEqual(['第一条', '第二条', '第三条'])
+    for (let index = 0; index < 15; index += 1) child.stdout.emit('data', Buffer.from(`第${index}行\n`))
+    child.emitClose(1)
+    expect(errors).toHaveLength(1)
+    const details = errors[0]?.technicalDetails ?? ''
+    expect(details.startsWith('退出码：1\n')).toBe(true)
+    expect(details.split('\n')).toHaveLength(11)
+    expect(details).toContain('第14行')
+    expect(details).not.toContain('第一条')
+  })
+
+  it('is unavailable without the helper', () => {
+    expect(updater({ helperPath: '' }).available()).toBe(false)
+    expect(updater().available()).toBe(true)
+  })
+
+  it('encodes the installed version with its rpm release', () => {
+    expect(currentLinuxVersion()).toMatch(/^0\.2\.2(?:-alpha\.2|-z\.|$)/)
+  })
+})
