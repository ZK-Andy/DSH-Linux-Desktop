@@ -0,0 +1,43 @@
+import { expect, it } from 'vitest'
+import { parseReleaseFeed } from '../src/update-feed.ts'
+
+const manifest = {
+  version: '0.2.2-alpha.2.2',
+  tag: 'v0.2.2-alpha.2-2',
+  rpmVersion: '0.2.2~alpha.2',
+  rpmRelease: '2',
+  package: 'dsh-desktop-0.2.2-alpha.2-x86_64.rpm',
+  sha256: 'a'.repeat(64),
+  bytes: 238565069,
+  publishedAt: '2026-10-30T19:19:52Z',
+  signingKeyId: '428be141c85f90ee',
+}
+
+it('accepts the manifest published by scripts/make-version-json.sh', () => {
+  expect(parseReleaseFeed(manifest)).toEqual(manifest)
+})
+
+it('keeps optional fields away when they are absent', () => {
+  const required: Record<string, unknown> = { ...manifest }
+  delete required.publishedAt
+  delete required.signingKeyId
+  const parsed = parseReleaseFeed(required)
+  expect(parsed).not.toHaveProperty('publishedAt')
+  expect(parsed).not.toHaveProperty('signingKeyId')
+})
+
+it.each([
+  ['bytes', { ...manifest, bytes: 0 }],
+  ['package', { ...manifest, package: 'dsh-desktop.rpm.sh' }],
+  ['sha256', { ...manifest, sha256: 'XYZ' }],
+  ['version', { ...manifest, version: '0.2.2-alpha.2-2' }],
+  ['tag', { ...manifest, tag: 'v0.2.2' }],
+  ['rpmRelease', { ...manifest, rpmRelease: 'alpha' }],
+])('rejects a manifest whose %s is not publishable', (_field, value) => {
+  expect(() => parseReleaseFeed(value)).toThrow(/更新清单的/)
+})
+
+it('rejects values that are not an object', () => {
+  expect(() => parseReleaseFeed([])).toThrow(/不是对象/)
+  expect(() => parseReleaseFeed(null)).toThrow(/不是对象/)
+})
