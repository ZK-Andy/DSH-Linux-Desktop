diff --git a/apps/desktop/tests/update-linux.spec.ts b/apps/desktop/tests/update-linux.spec.ts
new file mode 100644
index 00000000..aae3aa18
--- /dev/null
+++ b/apps/desktop/tests/update-linux.spec.ts
@@ -0,0 +1,469 @@
+import { existsSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { gt } from 'semver'
+import { afterAll, describe, expect, it, vi } from 'vitest'
+import {
+  INSTALL_TIMEOUT_MS, LinuxPackageUpdater, PKEXEC_NOT_AUTHORIZED, QUERY_TIMEOUT_MS,
+  currentLinuxVersion, encodeVersion, hasChannelSections, parseUpgrade, stripProgress,
+} from '../src/update-linux.ts'
+
+const logsDirectory = await vi.hoisted(async () => {
+  const { mkdtempSync } = await import('node:fs')
+  const { tmpdir } = await import('node:os')
+  return mkdtempSync(`${tmpdir()}/dsh-update-logs-`)
+})
+
+afterAll(() => { rmSync(logsDirectory, { recursive: true, force: true }) })
+
+/** What the rpm installs: both channel sections in one file. */
+const channelRepo = join(logsDirectory, 'channel.repo')
+writeFileSync(channelRepo, [
+  '[dsh-desktop]', 'name=DSH Linux Desktop (stable)', 'enabled=1', 'skip_if_unavailable=1', '',
+  '[dsh-desktop-nightly]', 'name=DSH Linux Desktop (nightly)', 'enabled=0', 'skip_if_unavailable=1', '',
+].join('\n'))
+
+/** What a locally edited `%config(noreplace)` file from an older rpm still looks like. */
+const legacyRepo = join(logsDirectory, 'legacy.repo')
+writeFileSync(legacyRepo, [
+  '[dsh-desktop]', 'name=DSH Linux Desktop', 'baseurl=https://zk-andy.github.io/DSH-Linux-Desktop/',
+  'enabled=1', 'gpgcheck=1', 'repo_gpgcheck=1', 'metadata_expire=1h', 'skip_if_unavailable=1', '',
