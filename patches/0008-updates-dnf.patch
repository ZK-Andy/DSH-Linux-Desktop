diff --git a/apps/desktop/tests/update-linux.spec.ts b/apps/desktop/tests/update-linux.spec.ts
new file mode 100644
index 00000000..c9f6d2c7
--- /dev/null
+++ b/apps/desktop/tests/update-linux.spec.ts
@@ -0,0 +1,92 @@
+import { gt } from 'semver'
+import { describe, expect, it, vi } from 'vitest'
+import {
+  LinuxPackageUpdater, currentLinuxVersion, encodeVersion, parseUpgrade,
+} from '../src/update-linux.ts'
+
+vi.mock('electron', () => ({
+  app: { getVersion: () => '0.2.2-alpha.2', relaunch: vi.fn(), exit: vi.fn() },
+}))
+
+function updater(overrides: Partial<ConstructorParameters<typeof LinuxPackageUpdater>[0]> = {}) {
+  return new LinuxPackageUpdater({
+    helperPath: '/bin/sh',
+    currentVersion: () => '0.2.2-alpha.2.5',
+    queryUpgrades: async () => '',
+    relaunch: vi.fn(),
+    ...overrides,
+  })
+}
+
+describe('encodeVersion', () => {
+  it('keeps the prerelease segment of an rpm EVR and appends the release', () => {
+    expect(encodeVersion('0.2.2~alpha.2-6', '')).toBe('0.2.2-alpha.2.6')
+    expect(encodeVersion('0:0.2.2~alpha.2-6', '')).toBe('0.2.2-alpha.2.6')
+    expect(encodeVersion('0.2.2~alpha.2', '6')).toBe('0.2.2-alpha.2.6')
+  })
+
+  it('marks stable builds so they sort after prereleases of the same version', () => {
+    expect(encodeVersion('0.2.3-1', '')).toBe('0.2.3-z.1')
+    expect(encodeVersion('0.2.3', '4')).toBe('0.2.3-z.4')
+  })
+
+  it('orders releases the way rpm orders them', () => {
+    expect(gt(encodeVersion('0.2.2~alpha.2-10', ''), encodeVersion('0.2.2~alpha.2-9', ''))).toBe(true)
+    expect(gt(encodeVersion('0.2.2~alpha.3-1', ''), encodeVersion('0.2.2~alpha.2-10', ''))).toBe(true)
+    expect(gt(encodeVersion('0.2.3-1', ''), encodeVersion('0.2.2~alpha.2-9', ''))).toBe(true)
+    expect(gt(encodeVersion('0.2.3~alpha.1-1', ''), encodeVersion('0.2.2-9', ''))).toBe(true)
+  })
+})
+
+describe('parseUpgrade', () => {
+  it('returns the first reported EVR and ignores blank lines', () => {
+    expect(parseUpgrade('0.2.2~alpha.2-6\n\n')).toBe('0.2.2~alpha.2-6')
+    expect(parseUpgrade('')).toBeUndefined()
+    expect(parseUpgrade('\n \n')).toBeUndefined()
+  })
+})
+
+describe('LinuxPackageUpdater', () => {
+  it('reports the encoded candidate when dnf sees an upgrade', async () => {
+    const u = updater({ queryUpgrades: async () => '0.2.2~alpha.2-6\n' })
+    await expect(u.checkForUpdates()).resolves.toEqual({
+      updateInfo: { version: '0.2.2-alpha.2.6' }, isUpdateAvailable: true,
+    })
+  })
+
+  it('reports the current version when dnf sees no upgrade', async () => {
+    const u = updater()
+    await expect(u.checkForUpdates()).resolves.toEqual({
+      updateInfo: { version: '0.2.2-alpha.2.5' }, isUpdateAvailable: false,
+    })
+  })
+
+  it('turns an empty check into a preparation failure instead of an install', async () => {
+    const u = updater()
+    await expect(u.downloadUpdate()).rejects.toThrow('没有已检查的更新')
+  })
+
+  it('prepares the install by reporting the candidate, not by downloading a package', async () => {
+    const u = updater({ queryUpgrades: async () => '0.2.2~alpha.2-6\n' })
+    await u.checkForUpdates()
+    const downloaded = vi.fn()
+    u.on('update-downloaded', downloaded)
+    await u.downloadUpdate()
+    expect(downloaded).toHaveBeenCalledWith({ version: '0.2.2-alpha.2.6' })
+  })
+
+  it('refuses to prepare when the helper is missing', async () => {
+    const u = updater({ helperPath: '/nonexistent/dsh-update-helper', queryUpgrades: async () => '0.2.2~alpha.2-6\n' })
+    await u.checkForUpdates()
+    await expect(u.downloadUpdate()).rejects.toThrow('没有 polkit helper')
+  })
+
+  it('is unavailable without the helper', () => {
+    expect(updater({ helperPath: undefined }).available()).toBe(false)
+    expect(updater().available()).toBe(true)
+  })
+
+  it('encodes the installed version with its rpm release', () => {
+    expect(currentLinuxVersion()).toMatch(/^0\.2\.2(?:-alpha\.2|-z\.|$)/)
+  })
+})
