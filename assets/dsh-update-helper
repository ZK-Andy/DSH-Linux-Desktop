#!/bin/sh
# 由 pkexec 以 root 调用的唯一入口：安装用户已经下载并校验过的 dsh-desktop rpm。
#
# 参数只有一个：缓存目录里的 rpm 绝对路径。脚本只接受我们自己写的那两个缓存目录，
# 并强制对本地包做 OpenPGP 校验（localpkg_gpgcheck=1），与 PLAN §3.4 一致。
set -eu

LOG_DIR=/var/log/dsh-desktop
LOG="$LOG_DIR/update.log"
mkdir -p "$LOG_DIR"
chmod 0755 "$LOG_DIR"

log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"; }

if [ "$#" -ne 1 ]; then
  log "拒绝：参数个数为 $#，只接受一个 rpm 路径"
  exit 64
fi

case "$1" in
  /home/*/.cache/dsh-desktop/dsh-desktop-*.rpm) ;;
  /var/cache/dsh-desktop/dsh-desktop-*.rpm) ;;
  *) log "拒绝：不在更新缓存的 rpm：$1"; exit 64 ;;
esac

if [ ! -f "$1" ]; then
  log "找不到包：$1"
  exit 66
fi

if [ "$(id -u)" -ne 0 ]; then
  log "拒绝：必须经 pkexec 以 root 运行"
  exit 77
fi

log "开始安装 $1"
rpm --import /opt/deepseek-harness-desktop/resources/RPM-GPG-KEY-dsh-desktop >>"$LOG" 2>&1 || {
  log "导入签名公钥失败"
  exit 70
}

if dnf5 install -y --setopt=localpkg_gpgcheck=1 "$1" >>"$LOG" 2>&1; then
  log "安装成功"
  exit 0
fi

log "安装失败，见上方 dnf5 输出"
exit 1
