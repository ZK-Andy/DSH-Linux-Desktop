[dsh-desktop]
name=DSH Linux Desktop
baseurl=https://zk-andy.github.io/DSH-Linux-Desktop/
enabled=1
gpgcheck=1
repo_gpgcheck=1
# 公钥由本包装在 /etc/pki/rpm-gpg/，不依赖网络；%post 会做一次幂等导入。
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-dsh-desktop
metadata_expire=1h
# 仓库不可达时不影响其他 dnf 事务；应用内检查会显式关掉这一项以便报错。
skip_if_unavailable=1
